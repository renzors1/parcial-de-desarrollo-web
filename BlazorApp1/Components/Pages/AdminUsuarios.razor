@page "/admin/usuarios"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Administración de Usuarios y Clientes</PageTitle>

<div class="container my-4">
    <!-- Encabezado con Botón Crear -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark font-editorial">Gestión de Usuarios y Clientes</h1>
            <p class="text-muted mb-0">Directorio de cuentas registradas, permisos de acceso y roles de la librería</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-2 px-3 shadow-2xs" @onclick="CargarUsuarios">
                <span class="bi bi-arrow-clockwise me-1"></span> Actualizar
            </button>
            <button class="btn btn-primary rounded-2 px-3 shadow-2xs" @onclick="AbrirModalNuevo">
                <span class="bi bi-person-plus-fill me-1"></span> Nuevo Usuario
            </button>
        </div>
    </div>

    @if (!TokenService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-shield-lock me-2"></span>
            <strong>Aviso de Seguridad:</strong> Debes iniciar sesión con perfil de administrador para auditar cuentas de usuario.
        </div>
    }

    @if (mensajeAlerta != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-info-circle-fill me-2"></span> @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-primary border p-3 me-3">
                        <span class="bi bi-people-fill fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Registrados</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@usuarios.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-success-subtle text-success border border-success-subtle p-3 me-3">
                        <span class="bi bi-person-check-fill fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Clientes Lectores</span>
                        <h3 class="fw-bold text-success mb-0 font-editorial">@usuarios.Count(u => !u.IsAdmin)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-warning-subtle text-warning border border-warning-subtle p-3 me-3">
                        <span class="bi bi-shield-lock-fill fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Administradores</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@usuarios.Count(u => u.IsAdmin)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-info border p-3 me-3">
                        <span class="bi bi-check2-circle fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Cuentas Activas</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@usuarios.Count(u => u.Activated)</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card border shadow-2xs rounded-2 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, usuario o correo..." @bind="terminoBusqueda" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select class="form-select rounded-2" @bind="filtroRol">
                    <option value="TODOS">Todos los roles</option>
                    <option value="CLIENTES">Solo Clientes</option>
                    <option value="ADMINS">Solo Administradores</option>
                </select>
            </div>
            <div class="col-6 col-md-4">
                <select class="form-select rounded-2" @bind="filtroEstado">
                    <option value="TODOS">Todos los estados</option>
                    <option value="ACTIVAS">Cuentas Activas</option>
                    <option value="INACTIVAS">Cuentas Inactivas</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Listado de Usuarios -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando directorio de usuarios...</p>
        </div>
    }
    else if (usuariosFiltrados.Count == 0)
    {
        <div class="card border shadow-2xs rounded-2 p-5 text-center bg-white">
            <span class="bi bi-people text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No se encontraron usuarios</h4>
            <p class="text-muted">No existen coincidencias con los filtros de búsqueda aplicados.</p>
        </div>
    }
    else
    {
        <div class="card border shadow-2xs rounded-2 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Usuario / Cuenta</th>
                            <th>Nombres y Apellidos</th>
                            <th>Correo Electrónico</th>
                            <th>Rol / Permisos</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in usuariosFiltrados)
                        {
                            var iniciales = ObtenerIniciales(u);
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center bg-light border text-primary fw-bold" style="width: 40px; height: 40px; font-size: 0.95rem;">
                                            @iniciales
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@@@u.Login</div>
                                            <small class="text-muted">ID: #@(u.Id ?? 0)</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark font-editorial">
                                        @($"{u.FirstName} {u.LastName}".Trim())
                                    </div>
                                    @if (string.IsNullOrWhiteSpace($"{u.FirstName} {u.LastName}".Trim()))
                                    {
                                        <small class="text-muted fst-italic">Sin nombre registrado</small>
                                    }
                                </td>
                                <td>
                                    <a href="mailto:@u.Email" class="text-decoration-none text-secondary">
                                        <span class="bi bi-envelope me-1"></span>@u.Email
                                    </a>
                                </td>
                                <td>
                                    @if (u.IsAdmin)
                                    {
                                        <span class="badge bg-warning text-dark border px-2 py-1 rounded-2">
                                            <span class="bi bi-shield-lock-fill me-1"></span> Administrador
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary text-white border px-2 py-1 rounded-2">
                                            <span class="bi bi-person-check me-1"></span> Cliente Lector
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (u.Activated)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-2">
                                            <span class="bi bi-check-circle-fill me-1"></span> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-2">
                                            <span class="bi bi-x-circle-fill me-1"></span> Inactivo
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-secondary rounded-2 me-1" @onclick="() => AbrirModalEditar(u)">
                                        <span class="bi bi-pencil me-1"></span> Editar
                                    </button>
                                    @if (u.Login != TokenService.CurrentUser?.Login)
                                    {
                                        <button class="btn btn-sm @(u.Activated ? "btn-outline-danger" : "btn-outline-success") rounded-2 px-2" @onclick="() => ToggleEstadoUsuario(u)" title="@(u.Activated ? "Desactivar cuenta" : "Activar cuenta")">
                                            <span class="bi @(u.Activated ? "bi-slash-circle" : "bi-check-circle")"></span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal para Crear / Editar Usuario -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark font-editorial">
                        <span class="bi bi-person-gear text-primary me-2"></span>
                        @(usuarioActual.Id.HasValue && usuarioActual.Id > 0 ? "Editar Usuario / Cliente" : "Registrar Nuevo Usuario")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Nombre de Usuario (Login) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-2 fs-6 @(esModoEdicion ? "bg-light text-muted" : "")" 
                                   placeholder="Ej. juanperez" @bind="usuarioActual.Login" maxlength="50" 
                                   disabled="@esModoEdicion" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control rounded-2 fs-6" placeholder="correo@ejemplo.com" @bind="usuarioActual.Email" maxlength="100" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Nombres <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-2 fs-6" placeholder="Juan" @bind="usuarioActual.FirstName" maxlength="50" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Apellidos</label>
                            <input type="text" class="form-control rounded-2 fs-6" placeholder="Pérez" @bind="usuarioActual.LastName" maxlength="50" />
                        </div>

                        @if (!esModoEdicion)
                        {
                            <div class="col-12">
                                <label class="form-label fw-semibold text-secondary small">Contraseña Temporal <span class="text-danger">*</span></label>
                                <input type="password" class="form-control rounded-2 fs-6" placeholder="Mínimo 4 caracteres" @bind="passwordNuevo" maxlength="100" required />
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Rol en el Sistema <span class="text-danger">*</span></label>
                            <select class="form-select rounded-2" @bind="rolSeleccionado">
                                <option value="ROLE_USER">Cliente Lector (Lectura y compra)</option>
                                <option value="ROLE_ADMIN">Administrador (Gestión total)</option>
                            </select>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" id="chkUsuarioActivo" @bind="usuarioActual.Activated" />
                                <label class="form-check-label fw-semibold text-dark small" for="chkUsuarioActivo">
                                    Cuenta activada y habilitada
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-2 px-4 fw-semibold" disabled="@guardando" @onclick="GuardarUsuario">
                        @if (guardando)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span>Guardar Usuario</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<UserAccountDto> usuarios = new();
    private UserAccountDto usuarioActual = new();
    private string passwordNuevo = "";
    private string rolSeleccionado = "ROLE_USER";
    private bool esModoEdicion = false;
    private bool cargando = true;
    private bool guardando = false;
    private bool mostrarModal = false;
    private string terminoBusqueda = "";
    private string filtroRol = "TODOS";
    private string filtroEstado = "TODOS";
    private string? mensajeAlerta = null;

    private List<UserAccountDto> usuariosFiltrados => usuarios
        .Where(u => filtroRol == "TODOS" ||
                    (filtroRol == "ADMINS" && u.IsAdmin) ||
                    (filtroRol == "CLIENTES" && !u.IsAdmin))
        .Where(u => filtroEstado == "TODOS" ||
                    (filtroEstado == "ACTIVAS" && u.Activated) ||
                    (filtroEstado == "INACTIVAS" && !u.Activated))
        .Where(u => string.IsNullOrWhiteSpace(terminoBusqueda) ||
                    u.Login.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    (u.Email?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.FirstName?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.LastName?.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        try
        {
            usuarios = await AuthService.ObtenerTodosLosUsuariosAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar usuarios: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        usuarioActual = new UserAccountDto
        {
            Activated = true,
            Authorities = new List<string> { "ROLE_USER" }
        };
        passwordNuevo = "";
        rolSeleccionado = "ROLE_USER";
        esModoEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(UserAccountDto u)
    {
        usuarioActual = new UserAccountDto
        {
            Id = u.Id,
            Login = u.Login,
            FirstName = u.FirstName,
            LastName = u.LastName,
            Email = u.Email,
            Activated = u.Activated,
            Authorities = new List<string>(u.Authorities)
        };
        rolSeleccionado = u.IsAdmin ? "ROLE_ADMIN" : "ROLE_USER";
        passwordNuevo = "";
        esModoEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarUsuario()
    {
        if (rolSeleccionado == "ROLE_ADMIN")
        {
            usuarioActual.Authorities = new List<string> { "ROLE_ADMIN", "ROLE_USER" };
        }
        else
        {
            usuarioActual.Authorities = new List<string> { "ROLE_USER" };
        }

        guardando = true;
        try
        {
            var (exito, error) = await AuthService.GuardarUsuarioPorAdminAsync(usuarioActual, passwordNuevo);
            if (exito)
            {
                mensajeAlerta = $"Usuario '{usuarioActual.Login}' guardado correctamente.";
                mostrarModal = false;
                await CargarUsuarios();
            }
            else
            {
                mensajeAlerta = error ?? "No se pudo guardar el usuario.";
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task ToggleEstadoUsuario(UserAccountDto u)
    {
        var nuevoEstado = !u.Activated;
        var ok = await AuthService.CambiarEstadoUsuarioAsync(u.Login, nuevoEstado);
        if (ok)
        {
            u.Activated = nuevoEstado;
            mensajeAlerta = $"Estado de '{u.Login}' actualizado a {(nuevoEstado ? "Activo" : "Inactivo")}.";
        }
    }

    private string ObtenerIniciales(UserAccountDto u)
    {
        var f = (u.FirstName ?? u.Login ?? "U").Trim();
        var l = (u.LastName ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(f) && !string.IsNullOrWhiteSpace(l))
        {
            return $"{f[0]}{l[0]}".ToUpper();
        }
        return (f.Length > 0 ? f[0].ToString() : "U").ToUpper();
    }
}
