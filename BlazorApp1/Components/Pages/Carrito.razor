    private async Task ProcesarCheckout()
    {
        if (!TokenService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login?returnUrl=/carrito");
            return;
        }

        var titularLimpio = (nombreTitular ?? "").Trim();
        if (string.IsNullOrWhiteSpace(titularLimpio) || titularLimpio.Length < 3 || titularLimpio.Length > 100)
        {
            errorMensaje = "Por favor verifica el Nombre y Apellidos de tu cuenta en tu Perfil.";
            return;
        }

        var correoLimpio = (correoCliente ?? "").Trim();
        if (string.IsNullOrWhiteSpace(correoLimpio) || !correoLimpio.Contains("@") || !correoLimpio.Contains(".") || correoLimpio.Length > 100)
        {
            errorMensaje = "Por favor verifica tu Correo Electrónico en tu Perfil para emitir tus licencias digitales.";
            return;
        }

        if (CarritoService.Items.Count == 0)
        {
            errorMensaje = "Tu carrito de compras está vacío.";
            return;
        }

        if (CarritoService.Items.Any(i => i.Cantidad <= 0 || i.Cantidad > CarritoService.MaxCantidadPorTitulo))
        {
            errorMensaje = $"La cantidad permitida por título es de 1 a {CarritoService.MaxCantidadPorTitulo} unidades.";
            return;
        }

        // Validaciones estrictas de métodos de pago
        if (metodoPago == "TARJETA")
        {
            var rawCard = numeroTarjeta.Replace(" ", "").Replace("-", "").Trim();
            if (rawCard.Length != 16 || !rawCard.All(char.IsDigit))
            {
                errorMensaje = "Error: El número de tarjeta debe tener exactamente 16 dígitos numéricos.";
                return;
            }

            var nomLimpio = nombreTarjeta.Trim();
            if (nomLimpio.Length < 3 || nomLimpio.Length > 60 || !nomLimpio.All(c => char.IsLetter(c) || char.IsWhiteSpace(c)))
            {
                errorMensaje = "Error: El nombre del titular en la tarjeta debe contener entre 3 y 60 caracteres alfabéticos.";
                return;
            }

            var vencLimpio = vencimientoTarjeta.Trim();
            if (!System.Text.RegularExpressions.Regex.IsMatch(vencLimpio, @"^(0[1-9]|1[0-2])\/?([2-9][0-9])$"))
            {
                errorMensaje = "Error: La fecha de vencimiento debe tener el formato MM/AA (ej. 12/28).";
                return;
            }

            var parts = vencLimpio.Split('/');
            if (parts.Length == 2 && int.TryParse(parts[0], out int mes) && int.TryParse(parts[1], out int anio))
            {
                var anioCompleto = 2000 + anio;
                if (anioCompleto < 2026 || (anioCompleto == 2026 && mes < 11))
                {
                    errorMensaje = "Error: La tarjeta indicada ya se encuentra vencida.";
                    return;
                }
            }

            var cvvLimpio = cvvTarjeta.Trim();
            if ((cvvLimpio.Length != 3 && cvvLimpio.Length != 4) || !cvvLimpio.All(char.IsDigit))
            {
                errorMensaje = "Error: El código de seguridad CVV debe tener 3 o 4 dígitos numéricos.";
                return;
            }
        }
        else if (metodoPago == "BILLETERA")
        {
            var telLimpio = telefonoBilletera.Trim();
            if (telLimpio.Length != 9 || !telLimpio.StartsWith("9") || !telLimpio.All(char.IsDigit))
            {
                errorMensaje = "Error: El número de celular para Yape/Plin debe tener exactamente 9 dígitos e iniciar con 9.";
                return;
            }

            var codLimpio = codigoOperacion.Trim();
            if (codLimpio.Length < 6 || codLimpio.Length > 8 || !codLimpio.All(char.IsDigit))
            {
                errorMensaje = "Error: El código de operación debe contener entre 6 y 8 dígitos numéricos.";
                return;
            }
        }

        nombreTitular = titularLimpio;
        correoCliente = correoLimpio;
        procesando = true;
        errorMensaje = null;

        try
