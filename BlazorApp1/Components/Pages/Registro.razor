@page "/registro"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registro de Nuevo Lector - BookStore</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border shadow-sm rounded-2 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="bi bi-person-plus display-5 text-primary"></span>
                    <h2 class="fw-bold mt-2 text-dark font-editorial">Registro de Lector</h2>
                    <p class="text-muted small">Crea tu cuenta de cliente para adquirir libros y gestionar tus licencias DRM</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 rounded-2 small text-center" role="alert">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success py-3 rounded-2 text-center" role="alert">
                        <span class="bi bi-check-circle-fill me-2"></span>
                        <strong>¡Registro completado!</strong> Tu cuenta ha sido activada. Redirigiendo al inicio de sesión...
                    </div>
                }
                else
                {
                    <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
                        <DataAnnotationsValidator />

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Nombres</label>
                                <InputText class="form-control rounded-2 fs-6" placeholder="Juan" @bind-Value="registerModel.FirstName" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold text-secondary small">Apellidos</label>
                                <InputText class="form-control rounded-2 fs-6" placeholder="Pérez" @bind-Value="registerModel.LastName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Nombre de Usuario (Login)</label>
                            <InputText class="form-control rounded-2 fs-6" placeholder="juanperez" @bind-Value="registerModel.Login" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                            <InputText type="email" class="form-control rounded-2 fs-6" placeholder="juan@ejemplo.com" @bind-Value="registerModel.Email" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Contraseña (Mínimo 4 caracteres)</label>
                            <InputText type="password" class="form-control rounded-2 fs-6" placeholder="Crea tu contraseña" @bind-Value="registerModel.Password" required />
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 rounded-2 fw-semibold shadow-2xs py-2 mb-3" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Creando cuenta...</span>
                            }
                            else
                            {
                                <span>Crear Cuenta de Lector</span>
                            }
                        </button>
                    </EditForm>
                }

                <hr class="opacity-25 my-3" />

                <div class="text-center">
                    <span class="text-muted small">¿Ya tienes una cuenta? </span>
                    <a href="/login" class="fw-semibold text-primary">Inicia sesión aquí</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var error = await AuthService.RegisterAsync(registerModel);
            if (string.IsNullOrWhiteSpace(error))
            {
                successMessage = "¡Cuenta creada exitosamente!";
                await Task.Delay(1000);
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = error;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al registrar usuario: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
