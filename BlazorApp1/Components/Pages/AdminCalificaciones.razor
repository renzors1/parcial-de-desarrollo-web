@page "/admin/calificaciones"
@rendermode InteractiveServer
@inject CalificacionService CalificacionService
@inject LibroService LibroService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Calificación de Clientes - EntreLíneas</PageTitle>

<div class="container my-4">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark font-editorial">Calificación de Clientes</h1>
            <p class="text-muted mb-0">Evaluación manual de clientes registrados por puntualidad de pago y comportamiento en la plataforma digital</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-2 px-3 shadow-2xs" @onclick="CargarCalificaciones">
                <span class="bi bi-arrow-clockwise me-1"></span> Actualizar
            </button>
            <button class="btn btn-primary rounded-2 px-3 shadow-2xs fw-semibold" @onclick="AbrirModalNueva">
                <span class="bi bi-plus-lg me-1"></span> Calificar Cliente
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-2 mb-4" role="alert">
            @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    @if (!TokenService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-shield-lock me-2"></span>
            <strong>Aviso de Seguridad:</strong> Inicia sesión con perfil administrativo para acceder a los datos de auditoría.
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-warning border p-3 me-3">
                        <span class="bi bi-star-fill fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Evaluaciones</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@calificaciones.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-success-subtle text-success border border-success-subtle p-3 me-3">
                        <span class="bi bi-emoji-smile fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Promedio General</span>
                        <h3 class="fw-bold text-success mb-0 font-editorial">
                            @(calificaciones.Count > 0 ? calificaciones.Average(c => c.Puntuacion).ToString("0.0") : "5.0") / 5
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-primary border p-3 me-3">
                        <span class="bi bi-trophy fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">5 Estrellas</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@calificaciones.Count(c => c.Puntuacion == 5)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-primary border p-3 me-3">
                        <span class="bi bi-chat-quote fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Con Comentario</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">
                            @calificaciones.Count(c => !string.IsNullOrWhiteSpace(c.Comentario))
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border shadow-2xs rounded-2 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por comentario o lector..." @bind="busqueda" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-12 col-md-6 d-flex justify-content-md-end gap-2">
                <div class="btn-group" role="group">
                    <button class="btn btn-sm @(filtroEstrellas == 0 ? "btn-primary" : "btn-outline-secondary") rounded-2 px-3 me-1" @onclick="() => filtroEstrellas = 0">Todas</button>
                    <button class="btn btn-sm @(filtroEstrellas == 5 ? "btn-warning text-dark" : "btn-outline-secondary") rounded-2 px-3 me-1" @onclick="() => filtroEstrellas = 5">5 Estrellas</button>
                    <button class="btn btn-sm @(filtroEstrellas == 4 ? "btn-warning text-dark" : "btn-outline-secondary") rounded-2 px-3 me-1" @onclick="() => filtroEstrellas = 4">4 Estrellas</button>
                    <button class="btn btn-sm @(filtroEstrellas == 3 ? "btn-secondary" : "btn-outline-secondary") rounded-2 px-3" @onclick="() => filtroEstrellas = 3">≤ 3 Estrellas</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Opiniones -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando opiniones...</p>
        </div>
    }
    else if (calificacionesFiltradas.Count == 0)
    {
        <div class="card border shadow-2xs rounded-2 p-5 text-center bg-white">
            <span class="bi bi-chat-square-dots text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No hay opiniones registradas</h4>
            <p class="text-muted">Aún no se han enviado reseñas con el filtro seleccionado.</p>
        </div>
    }
    else
    {
        <div class="card border shadow-2xs rounded-2 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Venta Asociada</th>
                            <th>Cliente Evaluado</th>
                            <th>Valoración</th>
                            <th>Reseña / Comentario</th>
                            <th>Fecha</th>
                            <th class="text-end pe-4">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cal in calificacionesFiltradas)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@cal.Id</td>
                                <td>
                                    <div class="fw-semibold text-dark small">
                                        @(cal.Venta?.NumeroComprobante ?? "Evaluación Directa")
                                    </div>
                                    <small class="text-muted">Evaluador: @(cal.EvaluadorTienda?.FirstName ?? "Administrador")</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(cal.ClienteEvaluado?.FirstName ?? cal.UsuarioCreacion ?? "Cliente Verificado")</div>
                                    <small class="text-muted">Cliente Registrado</small>
                                </td>
                                <td>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="bi @(i <= cal.Puntuacion ? "bi-star-fill text-warning" : "bi-star text-muted")"></span>
                                        }
                                        <span class="fw-bold text-dark ms-1">@cal.Puntuacion / 5</span>
                                    </div>
                                </td>
                                <td>
                                    <p class="text-secondary mb-0 small" style="max-width: 450px;">
                                        @(string.IsNullOrWhiteSpace(cal.Comentario) ? "Sin comentario adicional." : cal.Comentario)
                                    </p>
                                </td>
                                <td>
                                    <small class="text-muted">@cal.FechaCalificacion.ToString("dd/MM/yyyy HH:mm")</small>
                                </td>
                                <td class="text-end pe-4">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2 px-2 py-1 small">
                                        Publicada
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark font-editorial">
                        <span class="bi bi-star text-primary me-2"></span>Nueva Calificación de Cliente
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Cliente a Evaluar <span class="text-danger">*</span></label>
                            @if (!string.IsNullOrWhiteSpace(busquedaClienteModal))
                            {
                                <small class="text-muted">@clientesModalFiltrados.Count resultado(s)</small>
                            }
                        </div>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text bg-light"><span class="bi bi-search"></span></span>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Buscar cliente por nombre o usuario..."
                                   value="@busquedaClienteModal"
                                   @oninput="OnBusquedaClienteModalInput" />
                            @if (!string.IsNullOrWhiteSpace(busquedaClienteModal))
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarBusquedaClienteModal" title="Limpiar búsqueda">
                                    <span class="bi bi-x"></span>
                                </button>
                            }
                        </div>
                        <select class="form-select rounded-2" @bind="clienteSeleccionado">
                            @if (!clientesModalFiltrados.Any())
                            {
                                <option value="" disabled>No se encontraron clientes con ese criterio</option>
                            }
                            else
                            {
                                @foreach (var cli in clientesModalFiltrados.Take(50))
                                {
                                    <option value="@($"{cli.Nombre}|{cli.Login}")">@cli.Nombre (@cli.Login)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Puntuación (1 a 5) <span class="text-danger">*</span></label>
                        <select class="form-select rounded-2" @bind="nuevaPuntuacion">
                            <option value="5">5 - Excelente cliente</option>
                            <option value="4">4 - Muy buen cliente</option>
                            <option value="3">3 - Regular</option>
                            <option value="2">2 - Con incidencias</option>
                            <option value="1">1 - Deficiente</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Observación / Comentario</label>
                        <textarea class="form-control rounded-2" rows="3" @bind="nuevoComentario" placeholder="Ej. Pagos puntuales y activación correcta de licencias digitales..." maxlength="300"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-2 px-4 fw-semibold" @onclick="GuardarCalificacion" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar Calificación")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CalificacionUsuarioDto> calificaciones = new();
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool guardando = false;
    private string busqueda = "";
    private int filtroEstrellas = 0;

    private string clienteSeleccionado = "Carlos Mendoza|carlos.mendoza";
    private string busquedaClienteModal = "";
    private int nuevaPuntuacion = 5;
    private string nuevoComentario = "";
    private string? mensajeAlerta = null;
    private bool esError = false;

    private readonly List<(string Nombre, string Login)> _clientesCatalogo = new()
    {
        ("Carlos Mendoza", "carlos.mendoza"),
        ("Ana Torres", "ana.torres"),
        ("Usuario Cliente Demo", "user")
    };

    private List<(string Nombre, string Login)> clientesModalFiltrados => string.IsNullOrWhiteSpace(busquedaClienteModal)
        ? _clientesCatalogo
        : _clientesCatalogo.Where(c =>
            c.Nombre.Contains(busquedaClienteModal, StringComparison.OrdinalIgnoreCase) ||
            c.Login.Contains(busquedaClienteModal, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void OnBusquedaClienteModalInput(ChangeEventArgs e)
    {
        busquedaClienteModal = e.Value?.ToString() ?? "";
        var filtrados = clientesModalFiltrados;
        if (filtrados.Any())
        {
            var first = filtrados.First();
            clienteSeleccionado = $"{first.Nombre}|{first.Login}";
        }
        else
        {
            clienteSeleccionado = "";
        }
    }

    private void LimpiarBusquedaClienteModal()
    {
        busquedaClienteModal = "";
        var first = _clientesCatalogo.First();
        clienteSeleccionado = $"{first.Nombre}|{first.Login}";
    }

    private void AbrirModalNueva()
    {
        clienteSeleccionado = "Carlos Mendoza|carlos.mendoza";
        nuevaPuntuacion = 5;
        nuevoComentario = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarCalificacion()
    {
        guardando = true;
        try
        {
            var partes = clienteSeleccionado.Split('|');
            var nombre = partes.Length > 0 ? partes[0] : "Cliente";
            var login = partes.Length > 1 ? partes[1] : "user";

            var dto = new CalificacionUsuarioDto
            {
                Puntuacion = nuevaPuntuacion,
                Comentario = string.IsNullOrWhiteSpace(nuevoComentario) ? "Evaluación registrada por el administrador." : nuevoComentario.Trim(),
                FechaCalificacion = DateTime.Now,
                UsuarioCreacion = login,
                ClienteEvaluado = new UserAccountDto { FirstName = nombre, Login = login },
                EvaluadorTienda = new UserAccountDto { FirstName = TokenService.CurrentUser?.FirstName ?? "Administrador", Login = TokenService.CurrentUser?.Login ?? "admin" }
            };

            var ok = await CalificacionService.EnviarCalificacion(dto);
            if (ok)
            {
                mensajeAlerta = $"Calificación registrada para {nombre}.";
                esError = false;
                CerrarModal();
                await CargarCalificaciones();
            }
            else
            {
                mensajeAlerta = "No se pudo guardar la calificación.";
                esError = true;
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private List<CalificacionUsuarioDto> calificacionesFiltradas => calificaciones
        .Where(c => filtroEstrellas == 0 || (filtroEstrellas == 3 ? c.Puntuacion <= 3 : c.Puntuacion == filtroEstrellas))
        .Where(c => string.IsNullOrWhiteSpace(busqueda) ||
                    (c.Comentario?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.UsuarioCreacion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.ClienteEvaluado?.FirstName?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Venta?.NumeroComprobante?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarCalificaciones();
    }

    private async Task CargarCalificaciones()
    {
        cargando = true;
        try
        {
            calificaciones = await CalificacionService.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar calificaciones: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}
