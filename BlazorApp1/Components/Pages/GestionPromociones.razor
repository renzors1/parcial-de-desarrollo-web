@page "/admin/gestion-promociones-legacy"
@rendermode InteractiveServer
@inject PromocionService PromocionService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Gestión de Promociones</PageTitle>

<div class="container my-4">
    <!-- Encabezado con Botón Crear -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark">Gestión de Promociones y Descuentos</h1>
            <p class="text-muted mb-0">Configura cupones comerciales, porcentajes de descuento y cupos por campaña</p>
        </div>
        <button class="btn btn-danger btn-lg rounded-pill px-4 shadow-sm" @onclick="AbrirModalNuevaPromocion">
            <span class="bi bi-tag-fill me-2"></span> Nueva Promoción
        </button>
    </div>

    @if (!TokenService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-3 shadow-sm mb-4" role="alert">
            <span class="bi bi-shield-lock me-2"></span>
            <strong>Modo Demostración / Aviso:</strong> Inicia sesión como administrador para contar con autorización completa ante el servidor.
        </div>
    }

    @if (mensajeAlerta != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <span class="bi bi-info-circle-fill me-2"></span> @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-danger-subtle text-danger p-3 me-3">
                        <span class="bi bi-percent fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Promociones Activas</span>
                        <h3 class="fw-bold text-dark mb-0">@promociones.Count(p => p.EsVigente)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle text-primary p-3 me-3">
                        <span class="bi bi-ticket-perforated fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Cupos Totales</span>
                        <h3 class="fw-bold text-dark mb-0">@promociones.Sum(p => p.CantidadDefinida)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle text-success p-3 me-3">
                        <span class="bi bi-check-circle fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Cupos Disponibles</span>
                        <h3 class="fw-bold text-success mb-0">@promociones.Sum(p => p.CantidadDisponible)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle text-warning-emphasis p-3 me-3">
                        <span class="bi bi-graph-up-arrow fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Descuento Promedio</span>
                        <h3 class="fw-bold text-dark mb-0">
                            @(promociones.Count > 0 ? promociones.Average(p => p.PorcentajeDescuento).ToString("0.0") : "0")%
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Promociones -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status">
                <span class="visually-hidden">Cargando promociones...</span>
            </div>
            <p class="mt-2 text-muted">Cargando promociones comerciales...</p>
        </div>
    }
    else if (promociones.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <span class="bi bi-tag text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No hay promociones registradas</h4>
            <p class="text-muted">Crea la primera promoción con cupos limitados para tus clientes.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Campaña / Nombre</th>
                            <th>Descuento</th>
                            <th>Cupos (Disponibles / Total)</th>
                            <th>Vigencia</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var promo in promociones)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@promo.Nombre</div>
                                    <small class="text-muted">@promo.Descripcion</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                        -@promo.PorcentajeDescuento.ToString("0")%
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px; width: 100px;">
                                            <div class="progress-bar bg-success" role="progressbar" 
                                                 style="width: @(promo.CantidadDefinida > 0 ? (promo.CantidadDisponible * 100 / promo.CantidadDefinida) : 0)%">
                                            </div>
                                        </div>
                                        <small class="fw-semibold text-dark">
                                            @promo.CantidadDisponible / @promo.CantidadDefinida
                                        </small>
                                    </div>
                                </td>
                                <td>
                                    <small class="text-dark d-block">
                                        <span class="bi bi-calendar3 me-1"></span>
                                        @promo.FechaInicio.ToString("dd/MM/yy") - @promo.FechaFin.ToString("dd/MM/yy")
                                    </small>
                                </td>
                                <td>
                                    @if (promo.EsVigente)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <span class="bi bi-check-circle me-1"></span> Vigente
                                        </span>
                                    }
                                    else if (!promo.Activo)
                                    {
                                        <span class="badge bg-secondary-subtle text-muted rounded-pill px-3 py-1">
                                            Desactivada
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-3 py-1">
                                            Agotada / Expirada
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-secondary border-0 rounded-circle me-1" title="Editar" @onclick="() => AbrirModalEditar(promo)">
                                        <span class="bi bi-pencil"></span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Eliminar" @onclick="() => Eliminar(promo.Id)">
                                        <span class="bi bi-trash"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal para Crear o Editar Promoción -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-dark">
                        <span class="bi bi-tag-fill text-danger me-2"></span>
                        @(promocionActual.Id.HasValue ? "Editar Promoción" : "Registrar Nueva Promoción")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Nombre de la Campaña / Cupón:</label>
                        <input type="text" class="form-control rounded-3" placeholder="Ej. CYBERTECH30" @bind="promocionActual.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Descripción:</label>
                        <textarea class="form-control rounded-3" rows="2" placeholder="Detalle de los beneficios o libros aplicables..." @bind="promocionActual.Descripcion"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Porcentaje Descuento (%):</label>
                            <input type="number" min="1" max="100" class="form-control rounded-3" @bind="promocionActual.PorcentajeDescuento" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Cupos Disponibles:</label>
                            <input type="number" min="1" class="form-control rounded-3" @bind="promocionActual.CantidadDefinida" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Fecha de Inicio:</label>
                            <input type="date" class="form-control rounded-3" @bind="promocionActual.FechaInicio" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Fecha de Fin:</label>
                            <input type="date" class="form-control rounded-3" @bind="promocionActual.FechaFin" />
                        </div>
                    </div>

                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="activoSwitch" @bind="promocionActual.Activo" />
                        <label class="form-check-label fw-semibold small text-dark" for="activoSwitch">Promoción Activa</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" @onclick="GuardarPromocion">
                        <span class="bi bi-save me-1"></span> Guardar Promoción
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PromocionDto> promociones = new();
    private bool cargando = true;
    private string? mensajeAlerta = null;

    private bool mostrarModal = false;
    private PromocionDto promocionActual = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarPromociones();
    }

    private async Task CargarPromociones()
    {
        cargando = true;
        try
        {
            promociones = await PromocionService.GetAll();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar promociones: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevaPromocion()
    {
        promocionActual = new PromocionDto
        {
            PorcentajeDescuento = 20,
            CantidadDefinida = 100,
            CantidadDisponible = 100,
            FechaInicio = DateTime.UtcNow,
            FechaFin = DateTime.UtcNow.AddMonths(1),
            Activo = true
        };
        mostrarModal = true;
    }

    private void AbrirModalEditar(PromocionDto promo)
    {
        promocionActual = new PromocionDto
        {
            Id = promo.Id,
            Nombre = promo.Nombre,
            Descripcion = promo.Descripcion,
            PorcentajeDescuento = promo.PorcentajeDescuento,
            CantidadDefinida = promo.CantidadDefinida,
            CantidadDisponible = promo.CantidadDisponible,
            FechaInicio = promo.FechaInicio,
            FechaFin = promo.FechaFin,
            Activo = promo.Activo
        };
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarPromocion()
    {
        if (string.IsNullOrWhiteSpace(promocionActual.Nombre))
        {
            mensajeAlerta = "El nombre de la promoción es obligatorio.";
            return;
        }

        if (promocionActual.PorcentajeDescuento <= 0 || promocionActual.PorcentajeDescuento > 100)
        {
            mensajeAlerta = "El porcentaje debe estar entre 1% y 100%.";
            return;
        }

        bool exito;
        if (promocionActual.Id.HasValue)
        {
            exito = await PromocionService.Editar(promocionActual);
        }
        else
        {
            promocionActual.CantidadDisponible = promocionActual.CantidadDefinida;
            exito = await PromocionService.Crear(promocionActual);
        }

        if (exito)
        {
            mensajeAlerta = $"Promoción '{promocionActual.Nombre}' guardada correctamente.";
            mostrarModal = false;
            await CargarPromociones();
        }
        else
        {
            mensajeAlerta = "No se pudo guardar la promoción.";
        }
    }

    private async Task Eliminar(long? id)
    {
        if (!id.HasValue) return;
        var exito = await PromocionService.Eliminar(id.Value);
        if (exito)
        {
            mensajeAlerta = "Promoción eliminada con éxito.";
            await CargarPromociones();
        }
        else
        {
            mensajeAlerta = "Error al intentar eliminar la promoción.";
        }
    }
}
