@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject LibroService LibroService
@inject CarritoService CarritoService
@inject EditorialService EditorialService
@inject PromocionService PromocionService
@inject CalificacionService CalificacionService

<PageTitle>BookStore - Catálogo Editorial de Libros Digitales</PageTitle>

<!-- Hero Banner Editorial -->
<div class="p-4 p-md-5 mb-4 rounded-2 text-white shadow-sm" style="background-color: #0f172a; border-left: 4px solid #3b82f6;">
    <div class="container-fluid py-2">
        <span class="badge bg-primary px-3 py-1 rounded-2 mb-3 text-uppercase fw-semibold" style="letter-spacing: 0.05em;">Librería Digital & DRM</span>
        <h1 class="display-5 fw-bold mb-3 font-editorial">Publicaciones Especializadas en Tecnología y Software</h1>
        <p class="col-md-8 fs-5 text-light opacity-75 mb-4">
            Adquiere obras fundamentales en arquitectura de software, lenguajes modernos e infraestructura en la nube con acceso y lectura inmediata.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <a href="#catalogo" class="btn btn-light px-4 py-2 fw-semibold text-dark shadow-sm rounded-2">
                <span class="bi bi-book me-2"></span> Explorar Catálogo
            </a>
            <a href="/carrito" class="btn btn-outline-light px-4 py-2 rounded-2">
                <span class="bi bi-cart3 me-2"></span> Mi Carrito (@CarritoService.TotalItems)
            </a>
            <a href="/mis-libros" class="btn btn-outline-info px-4 py-2 rounded-2">
                <span class="bi bi-journal-bookmark me-2"></span> Mis Libros Digitales
            </a>
        </div>
    </div>
</div>

<!-- Filtros y Catálogo -->
<div class="container my-4" id="catalogo">
    <div class="row align-items-center mb-4 g-3">
        <div class="col-12 col-lg-5">
            <h2 class="h3 fw-bold mb-1 text-dark font-editorial">Catálogo de Publicaciones</h2>
            <p class="text-muted mb-0">Selecciona tus obras con entrega digital instantánea</p>
        </div>
        <div class="col-12 col-lg-7">
            <div class="row g-2">
                <div class="col-12 col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar título, autor o ISBN..." @bind="terminoBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <select class="form-select" @bind="categoriaSeleccionada">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in categoriasDisponibles)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-4">
                    <select class="form-select" @bind="editorialSeleccionada">
                        <option value="">Todas las editoriales</option>
                        @foreach (var ed in editorialesDisponibles)
                        {
                            <option value="@ed.NombreEditorial">@ed.NombreEditorial</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorCarga))
    {
        <div class="alert alert-danger rounded-2 shadow-sm p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
            <div class="d-flex align-items-center">
                <span class="bi bi-exclamation-triangle-fill fs-4 me-2 text-danger"></span>
                <span>@errorCarga</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger rounded-2 px-3" @onclick="CargarDatos">
                <span class="bi bi-arrow-clockwise me-1"></span> Reintentar
            </button>
        </div>
    }

    @if (mensajeCompra != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-2 shadow-sm mb-4" role="alert">
            <span class="bi bi-check-circle-fill me-2"></span>
            <strong>Agregado a tu bolsa:</strong> @mensajeCompra
            <button type="button" class="btn-close" @onclick="() => mensajeCompra = null"></button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Cargando catálogo editorial...</p>
        </div>
    }
    else if (librosFiltrados.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-2 border p-4">
            <span class="bi bi-journal-x text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No se encontraron títulos coincidentes</h4>
            <p class="text-muted">Intenta buscar con otros términos o restablece los filtros.</p>
            <button class="btn btn-outline-primary rounded-2 px-4 mt-2" @onclick="LimpiarFiltros">
                <span class="bi bi-arrow-counterclockwise me-1"></span> Restablecer Filtros
            </button>
        </div>
    }
    else
    {
        <!-- Cuadrícula de Libros -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var libro in librosFiltrados)
            {
                var promo = libro.PromocionActiva ?? promocionGeneral;
                var tieneDescuento = promo != null;
                var precioRebajado = tieneDescuento 
                    ? Math.Round(libro.Precio * (decimal)(1 - (promo!.PorcentajeDescuento / 100.0f)), 2)
                    : libro.Precio;
                var metricas = ObtenerMetricas(libro.Id);

                <div class="col">
                    <div class="card h-100 border shadow-sm rounded-2 overflow-hidden bg-white book-card d-flex flex-column">
                        <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                            <span class="badge bg-white text-dark border px-2 py-1 rounded-2 small">
                                @libro.CategoriaPrincipal
                            </span>
                            @if (tieneDescuento)
                            {
                                <span class="badge bg-danger text-white rounded-2 px-2 py-1 fw-bold">
                                    -@promo!.PorcentajeDescuento.ToString("0")% OFF
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2 px-2 py-1 small">
                                    Digital Inmediato
                                </span>
                            }
                        </div>

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="row g-3 mb-3">
                                <div class="col-4">
                                    <div class="book-cover-wrapper">
                                        @if (!string.IsNullOrWhiteSpace(libro.PortadaUrl))
                                        {
                                            <img src="@libro.PortadaUrl" alt="@libro.Titulo" class="book-cover-img" onerror="this.style.opacity='0'; this.style.display='none';" />
                                        }
                                        <div class="book-cover-fallback">
                                            <div class="small text-white-50">BookStore</div>
                                            <div class="fw-bold small font-editorial">@libro.Titulo</div>
                                            <div class="small text-white-50">@libro.NombreEditorial</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-8 d-flex flex-column justify-content-between">
                                    <div>
                                        <h5 class="card-title fw-bold text-dark mb-1 font-editorial" style="font-size: 1.05rem; line-height: 1.35;">
                                            @libro.Titulo
                                        </h5>
                                        <p class="text-muted small mb-1">
                                            <span class="bi bi-person me-1"></span>@libro.AutorPrincipal
                                        </p>
                                        <div class="small text-secondary mb-2">
                                            <span class="bi bi-building me-1"></span>@libro.NombreEditorial
                                        </div>
                                    </div>

                                    <!-- Calificación y Reseñas dinámicas -->
                                    <div class="d-flex align-items-center small mt-auto">
                                        <div class="text-warning me-1">
                                            <span class="bi bi-star-fill"></span>
                                        </div>
                                        <span class="fw-semibold text-dark me-1">@metricas.Rating.ToString("0.0")</span>
                                        <span class="text-muted">(@metricas.Resenas)</span>
                                    </div>
                                </div>
                            </div>

                            <p class="card-text text-secondary small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @(string.IsNullOrWhiteSpace(libro.Sinopsis) ? "Edición digital completa con licencia de lectura online autorizada." : libro.Sinopsis)
                            </p>

                            <hr class="my-2 opacity-25" />

                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                <div>
                                    <span class="text-muted small d-block" style="font-size: 0.75rem;">Precio digital</span>
                                    @if (tieneDescuento)
                                    {
                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="h5 fw-bold text-danger mb-0">S/ @precioRebajado.ToString("N2")</span>
                                            <span class="text-muted small text-decoration-line-through">S/ @libro.Precio.ToString("N2")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="h5 fw-bold text-dark mb-0">S/ @libro.Precio.ToString("N2")</span>
                                    }
                                </div>
                                @if (libro.Id.HasValue && librosAgregadosFeedback.Contains(libro.Id.Value))
                                {
                                    <button class="btn btn-success px-3 py-2 rounded-2 fw-medium shadow-2xs" disabled>
                                        <span class="bi bi-check-lg me-1"></span> ¡Agregado!
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-primary px-3 py-2 rounded-2 fw-medium shadow-2xs" @onclick="() => ComprarLibro(libro)">
                                        <span class="bi bi-cart-plus me-1"></span> Agregar
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<LibroDto> todosLosLibros = new();
    private List<EditorialDto> editorialesDisponibles = new();
    private List<CalificacionUsuarioDto> listaCalificaciones = new();
    private List<string> categoriasDisponibles = new();
    private PromocionDto? promocionGeneral = null;

    private bool cargando = true;
    private string? errorCarga = null;
    private string terminoBusqueda = "";
    private string categoriaSeleccionada = "";
    private string editorialSeleccionada = "";
    private string? mensajeCompra = null;
    private HashSet<long> librosAgregadosFeedback = new();

    private List<LibroDto> librosFiltrados => todosLosLibros
        .Where(l => string.IsNullOrWhiteSpace(terminoBusqueda) ||
                    l.Titulo.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    l.Isbn.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase) ||
                    l.AutorPrincipal.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase))
        .Where(l => string.IsNullOrWhiteSpace(categoriaSeleccionada) ||
                    l.Categoriases.Any(c => c.NombreCategoria.Equals(categoriaSeleccionada, StringComparison.OrdinalIgnoreCase)) ||
                    l.CategoriaPrincipal.Equals(categoriaSeleccionada, StringComparison.OrdinalIgnoreCase))
        .Where(l => string.IsNullOrWhiteSpace(editorialSeleccionada) ||
                    l.NombreEditorial.Equals(editorialSeleccionada, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        CarritoService.OnChange += StateHasChanged;
        await CargarDatos();
    }

    public void Dispose()
    {
        CarritoService.OnChange -= StateHasChanged;
    }

    private async Task CargarDatos()
    {
        cargando = true;
        errorCarga = null;
        try
        {
            todosLosLibros = await LibroService.GetAllAsync();
            editorialesDisponibles = await EditorialService.GetAll();
            try { listaCalificaciones = await CalificacionService.GetAll(); } catch { }

            var cats = todosLosLibros
                .SelectMany(l => l.Categoriases.Select(c => c.NombreCategoria))
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .ToList();

            if (cats.Count == 0)
            {
                cats = new List<string> { "Programación", "Arquitectura", "Cloud Computing", "Desarrollo Web", "Base de Datos" };
            }
            categoriasDisponibles = cats;

            var activas = await PromocionService.GetActivas();
            promocionGeneral = activas.FirstOrDefault();
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudo sincronizar el catálogo: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private (decimal Rating, int Resenas) ObtenerMetricas(long? libroId)
    {
        var id = libroId ?? 1;
        var reviews = listaCalificaciones.Where(c => c.LibroId == id).ToList();
        if (reviews.Count > 0)
        {
            return (Math.Round((decimal)reviews.Average(c => c.Puntuacion), 1), reviews.Count);
        }
        var determinista = Math.Round(4.4m + ((id % 5) * 0.1m), 1);
        var count = 18 + (int)((id * 7) % 45);
        return (determinista, count);
    }

    private void LimpiarFiltros()
    {
        terminoBusqueda = "";
        categoriaSeleccionada = "";
        editorialSeleccionada = "";
    }

    private void ComprarLibro(LibroDto libro)
    {
        CarritoService.AgregarLibro(libro);
        mensajeCompra = $"'{libro.Titulo}' se agregó a tu bolsa de compras.";
        if (libro.Id.HasValue)
        {
            var id = libro.Id.Value;
            librosAgregadosFeedback.Add(id);
            _ = Task.Run(async () =>
            {
                await Task.Delay(1500);
                librosAgregadosFeedback.Remove(id);
                await InvokeAsync(StateHasChanged);
            });
        }
    }
}
