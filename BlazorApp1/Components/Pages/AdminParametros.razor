@page "/admin/parametros"
@inject CatalogoConfigService CatalogoConfig
@inject EditorialService EditorialService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Parámetros del Catálogo - EntreLíneas</PageTitle>

@if (!TokenService.IsAdmin)
{
    <div class="container py-5">
        <div class="alert alert-danger rounded-2">
            Acceso denegado. Esta sección es exclusiva para administradores.
        </div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 fw-bold mb-1 font-editorial">Parámetros del Catálogo</h1>
                <p class="text-muted mb-0">Administra los idiomas, categorías y editoriales disponibles al registrar libros</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-2 mb-4" role="alert">
                @mensajeAlerta
                <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
            </div>
        }

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <button class="nav-link @(tabActivo == "idiomas" ? "active fw-semibold" : "")" @onclick='() => tabActivo = "idiomas"'>
                    <span class="bi bi-translate me-1"></span> Idiomas (@idiomas.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActivo == "categorias" ? "active fw-semibold" : "")" @onclick='() => tabActivo = "categorias"'>
                    <span class="bi bi-tags me-1"></span> Categorías (@categorias.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(tabActivo == "editoriales" ? "active fw-semibold" : "")" @onclick='() => tabActivo = "editoriales"'>
                    <span class="bi bi-building me-1"></span> Editoriales (@editoriales.Count)
                </button>
            </li>
        </ul>

        @if (tabActivo == "idiomas")
        {
            <div class="card border shadow-sm rounded-2">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 font-editorial">Agregar Nuevo Idioma</h5>
                    <div class="row g-2 mb-4">
                        <div class="col-md-8">
                            <input type="text" class="form-control rounded-2" placeholder="Ej. Portugués, Italiano, Catalán..." @bind="nuevoIdioma" maxlength="40" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100 rounded-2" @onclick="AgregarIdioma">
                                <span class="bi bi-plus-lg me-1"></span> Agregar Idioma
                            </button>
                        </div>
                    </div>

                    <h6 class="fw-semibold text-muted mb-3">Idiomas disponibles</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var idioma in idiomas)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 d-inline-flex align-items-center gap-2 fs-6 fw-normal">
                                @idioma
                                <button type="button" class="btn-close" style="font-size: 0.65rem;" title="Eliminar idioma" @onclick="() => EliminarIdioma(idioma)"></button>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
        else if (tabActivo == "categorias")
        {
            <div class="card border shadow-sm rounded-2">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 font-editorial">Agregar Nueva Categoría</h5>
                    <div class="row g-2 mb-4">
                        <div class="col-md-8">
                            <input type="text" class="form-control rounded-2" placeholder="Ej. Ciencia Ficción, Economía, Diseño UX..." @bind="nuevaCategoria" maxlength="50" />
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-primary w-100 rounded-2" @onclick="AgregarCategoria">
                                <span class="bi bi-plus-lg me-1"></span> Agregar Categoría
                            </button>
                        </div>
                    </div>

                    <h6 class="fw-semibold text-muted mb-3">Categorías disponibles</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var cat in categorias)
                        {
                            <span class="badge bg-light text-dark border px-3 py-2 d-inline-flex align-items-center gap-2 fs-6 fw-normal">
                                @cat
                                <button type="button" class="btn-close" style="font-size: 0.65rem;" title="Eliminar categoría" @onclick="() => EliminarCategoria(cat)"></button>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
        else if (tabActivo == "editoriales")
        {
            <div class="card border shadow-sm rounded-2">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 font-editorial">Registrar Nueva Editorial</h5>
                    <div class="row g-2 mb-4">
                        <div class="col-md-5">
                            <input type="text" class="form-control rounded-2" placeholder="Nombre de la editorial" @bind="nuevaEditorialNombre" maxlength="80" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control rounded-2" placeholder="País (Ej. Perú, España, México)" @bind="nuevaEditorialPais" maxlength="50" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-primary w-100 rounded-2" @onclick="AgregarEditorial">
                                <span class="bi bi-plus-lg me-1"></span> Agregar Editorial
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Editorial</th>
                                    <th>País</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ed in editoriales)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ed.NombreEditorial</td>
                                        <td><span class="badge bg-light text-secondary border">@ed.Pais</span></td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger rounded-2" @onclick="() => EliminarEditorial(ed.Id ?? 0)" title="Eliminar editorial">
                                                <span class="bi bi-trash"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private string tabActivo = "idiomas";
    private List<string> idiomas = new();
    private List<string> categorias = new();
    private List<EditorialDto> editoriales = new();

    private string nuevoIdioma = "";
    private string nuevaCategoria = "";
    private string nuevaEditorialNombre = "";
    private string nuevaEditorialPais = "";

    private string? mensajeAlerta = null;
    private bool esError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        idiomas = CatalogoConfig.GetIdiomas();
        categorias = CatalogoConfig.GetCategorias();
        editoriales = await EditorialService.GetAll();
    }

    private void MostrarMensaje(string msg, bool error = false)
    {
        mensajeAlerta = msg;
        esError = error;
    }

    private void AgregarIdioma()
    {
        if (string.IsNullOrWhiteSpace(nuevoIdioma))
        {
            MostrarMensaje("Ingresa el nombre del idioma.", true);
            return;
        }
        if (CatalogoConfig.AgregarIdioma(nuevoIdioma))
        {
            MostrarMensaje($"Idioma '{nuevoIdioma.Trim()}' agregado correctamente.");
            nuevoIdioma = "";
            idiomas = CatalogoConfig.GetIdiomas();
        }
        else
        {
            MostrarMensaje("Ese idioma ya existe en la lista.", true);
        }
    }

    private void EliminarIdioma(string idioma)
    {
        if (CatalogoConfig.EliminarIdioma(idioma))
        {
            idiomas = CatalogoConfig.GetIdiomas();
            MostrarMensaje($"Idioma '{idioma}' eliminado.");
        }
    }

    private void AgregarCategoria()
    {
        if (string.IsNullOrWhiteSpace(nuevaCategoria))
        {
            MostrarMensaje("Ingresa el nombre de la categoría.", true);
            return;
        }
        if (CatalogoConfig.AgregarCategoria(nuevaCategoria))
        {
            MostrarMensaje($"Categoría '{nuevaCategoria.Trim()}' agregada correctamente.");
            nuevaCategoria = "";
            categorias = CatalogoConfig.GetCategorias();
        }
        else
        {
            MostrarMensaje("Esa categoría ya existe en la lista.", true);
        }
    }

    private void EliminarCategoria(string categoria)
    {
        if (CatalogoConfig.EliminarCategoria(categoria))
        {
            categorias = CatalogoConfig.GetCategorias();
            MostrarMensaje($"Categoría '{categoria}' eliminada.");
        }
    }

    private async Task AgregarEditorial()
    {
        if (string.IsNullOrWhiteSpace(nuevaEditorialNombre) || string.IsNullOrWhiteSpace(nuevaEditorialPais))
        {
            MostrarMensaje("Ingresa tanto el nombre de la editorial como el país.", true);
            return;
        }

        var nueva = new EditorialDto
        {
            NombreEditorial = nuevaEditorialNombre.Trim(),
            Pais = nuevaEditorialPais.Trim(),
            Activo = true
        };

        var ok = await EditorialService.Create(nueva);
        if (ok)
        {
            MostrarMensaje($"Editorial '{nueva.NombreEditorial}' agregada correctamente.");
            nuevaEditorialNombre = "";
            nuevaEditorialPais = "";
            editoriales = await EditorialService.GetAll();
        }
        else
        {
            MostrarMensaje("No se pudo registrar la editorial.", true);
        }
    }

    private async Task EliminarEditorial(long id)
    {
        if (id <= 0) return;
        if (await EditorialService.Delete(id))
        {
            editoriales = await EditorialService.GetAll();
            MostrarMensaje("Editorial eliminada.");
        }
    }
}
