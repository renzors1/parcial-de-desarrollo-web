@page "/admin/promociones"
@rendermode InteractiveServer
@inject PromocionService PromocionService
@inject LibroService LibroService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Administración de Promociones</PageTitle>

<div class="container my-4">
    <!-- Encabezado con Botones de Acción -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark font-editorial">Campañas y Descuentos Comerciales</h1>
            <p class="text-muted mb-0">Gestión de cupones, porcentajes de descuento y cupos de venta</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary rounded-2 px-3 shadow-2xs" @onclick="CargarPromociones" disabled="@cargando" title="Recargar campañas">
                <span class="bi bi-arrow-clockwise @(cargando ? "spin" : "") me-1"></span> Actualizar
            </button>
            <button class="btn btn-primary rounded-2 px-3 shadow-2xs" @onclick="AbrirModalNuevaPromocion">
                <span class="bi bi-tag me-1"></span> Nueva Campaña
            </button>
        </div>
    </div>

    @if (!TokenService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-shield-lock me-2"></span>
            <strong>Aviso de Sesión:</strong> Inicia sesión como administrador para contar con autorización ante el servidor.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-check-circle-fill me-2"></span> @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-exclamation-triangle-fill me-2"></span> @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-success-subtle text-success border border-success-subtle p-3 me-3">
                        <span class="bi bi-check2-circle fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Campañas Vigentes</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@promociones.Count(p => p.EsVigente)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-primary-subtle text-primary border border-primary-subtle p-3 me-3">
                        <span class="bi bi-ticket-perforated fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Cupos Disponibles</span>
                        <h3 class="fw-bold text-primary mb-0 font-editorial">@promociones.Sum(p => p.CantidadDisponible)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-danger border p-3 me-3">
                        <span class="bi bi-percent fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Descuento Promedio</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">
                            @(promociones.Count > 0 ? promociones.Average(p => p.PorcentajeDescuento).ToString("0.0") : "0")%
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-warning-subtle text-warning-emphasis border border-warning-subtle p-3 me-3">
                        <span class="bi bi-alarm fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Por Vencer / Alertas</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@TotalAlertas</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="card border shadow-2xs rounded-2 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por nombre, código o descripción..." @bind="busquedaTexto" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(busquedaTexto))
                    {
                        <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => busquedaTexto = string.Empty">
                            <span class="bi bi-x"></span>
                        </button>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-7 d-flex justify-content-lg-end flex-wrap gap-1">
                <div class="btn-group flex-wrap" role="group">
                    <button class="btn btn-sm @(filtroEstado == "TODAS" ? "btn-primary" : "btn-outline-secondary") rounded-2 px-3 me-1 mb-1" @onclick='() => filtroEstado = "TODAS"'>
                        Todas (@promociones.Count)
                    </button>
                    <button class="btn btn-sm @(filtroEstado == "VIGENTES" ? "btn-success" : "btn-outline-secondary") rounded-2 px-3 me-1 mb-1" @onclick='() => filtroEstado = "VIGENTES"'>
                        Vigentes (@promociones.Count(p => p.EsVigente))
                    </button>
                    <button class="btn btn-sm @(filtroEstado == "POR_VENCER" ? "btn-warning text-dark" : "btn-outline-secondary") rounded-2 px-3 me-1 mb-1" @onclick='() => filtroEstado = "POR_VENCER"'>
                        ⏳ Por Vencer (@TotalAlertas)
                    </button>
                    <button class="btn btn-sm @(filtroEstado == "PROGRAMADAS" ? "btn-info text-white" : "btn-outline-secondary") rounded-2 px-3 me-1 mb-1" @onclick='() => filtroEstado = "PROGRAMADAS"'>
                        Programadas (@promociones.Count(p => p.EsProgramada))
                    </button>
                    <button class="btn btn-sm @(filtroEstado == "VENCIDAS_AGOTADAS" ? "btn-secondary" : "btn-outline-secondary") rounded-2 px-3 mb-1" @onclick='() => filtroEstado = "VENCIDAS_AGOTADAS"'>
                        Vencidas / Agotadas (@promociones.Count(p => !p.EsVigente && !p.EsProgramada))
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Listado de Promociones -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando campañas de descuento...</p>
        </div>
    }
    else if (promocionesFiltradas.Count == 0)
    {
        <div class="card border shadow-2xs rounded-2 p-5 text-center bg-white">
            <span class="bi bi-tag text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No se encontraron campañas promocionales</h4>
            <p class="text-muted">Prueba cambiando el criterio de búsqueda o crea una nueva promoción.</p>
        </div>
    }
    else
    {
        <div class="card border shadow-2xs rounded-2 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="min-width: 240px;">Campaña / Código</th>
                            <th style="min-width: 140px;">Descuento</th>
                            <th style="min-width: 140px;">Alcance</th>
                            <th style="min-width: 170px;">Cupos</th>
                            <th style="min-width: 160px;">Periodo</th>
                            <th style="min-width: 120px;">Estado</th>
                            <th class="text-end pe-4" style="min-width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var promo in promocionesFiltradas)
                        {
                            var badgeInfo = ObtenerBadgeEstado(promo);
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                        @if (promo.EsCupon)
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning font-monospace px-2 py-1" title="Cupón con código secreto para ingresar en el carrito">
                                                <span class="bi bi-ticket-perforated-fill text-warning me-1"></span>@promo.CodigoCupon
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" title="Oferta automática aplicada directamente en el catálogo">
                                                <span class="bi bi-shop me-1"></span>Oferta en Tienda
                                            </span>
                                        }
                                        <span class="fw-semibold text-dark font-editorial fs-6">@promo.Nombre</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(promo.Descripcion))
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 280px;" title="@promo.Descripcion">
                                            @promo.Descripcion
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (promo.EsMontoFijo)
                                    {
                                        <span class="badge bg-danger text-white rounded-2 px-2 py-1 fw-bold fs-6">
                                            -S/ @promo.DescuentoFijo.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white rounded-2 px-2 py-1 fw-bold fs-6">
                                            -@promo.PorcentajeDescuento.ToString("0")%
                                        </span>
                                    }

                                    @if (promo.TopeDescuento.HasValue && promo.TopeDescuento.Value > 0)
                                    {
                                        <small class="text-muted d-block mt-1" title="Tope máximo de descuento">
                                            <span class="bi bi-shield-check me-1"></span>Tope: S/ @promo.TopeDescuento.Value.ToString("N2")
                                        </small>
                                    }
                                    @if (promo.MontoMinimoCompra.HasValue && promo.MontoMinimoCompra.Value > 0)
                                    {
                                        <small class="text-muted d-block" title="Compra mínima requerida">
                                            <span class="bi bi-cart me-1"></span>Min: S/ @promo.MontoMinimoCompra.Value.ToString("N2")
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (promo.Libroses == null || promo.Libroses.Count == 0)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-2 px-2 py-1 small">
                                            <span class="bi bi-globe me-1"></span> Global
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-dark border rounded-2 px-2 py-1 small" title="@string.Join(", ", promo.Libroses.Select(l => l.Titulo))">
                                            <span class="bi bi-book me-1"></span> @promo.Libroses.Count @(promo.Libroses.Count == 1 ? "título" : "títulos")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var pct = promo.CantidadDefinida > 0 ? (int)Math.Round((double)promo.CantidadDisponible * 100 / promo.CantidadDefinida) : 0;
                                        var barColor = (pct <= 10 || promo.CantidadDisponible == 0) ? "bg-danger" : (pct <= 25 ? "bg-warning" : "bg-success");
                                        var alertPocosCupos = promo.CantidadDisponible > 0 && (pct <= 10 || promo.CantidadDisponible <= 5);
                                    }
                                    <div class="d-flex flex-column" style="max-width: 150px;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-semibold @(alertPocosCupos ? "text-danger fw-bold" : "text-dark")">
                                                @promo.CantidadDisponible / @promo.CantidadDefinida
                                            </span>
                                            @if (alertPocosCupos)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-1 py-0" style="font-size: 0.7rem;" title="Quedan pocos cupos disponibles">
                                                    <span class="bi bi-exclamation-triangle-fill"></span> Pocos
                                                </span>
                                            }
                                            else if (promo.CantidadDisponible == 0)
                                            {
                                                <span class="badge bg-secondary-subtle text-danger border rounded-pill px-1 py-0" style="font-size: 0.7rem;">
                                                    Agotado
                                                </span>
                                            }
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @barColor" role="progressbar" style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold">
                                        <span class="bi bi-calendar3 me-1 text-muted"></span>
                                        @promo.FechaInicio.ToString("dd/MM/yy") - @promo.FechaFin.ToString("dd/MM/yy")
                                    </div>
                                    @if (promo.EsVigente)
                                    {
                                        <small class="text-muted d-block">
                                            @(promo.DiasRestantes == 0 ? "Vence hoy" : $"Quedan {promo.DiasRestantes} días")
                                        </small>
                                    }
                                </td>
                                <td>
                                    <span class="@badgeInfo.BadgeClass rounded-2 px-2 py-1">
                                        @if (!string.IsNullOrWhiteSpace(badgeInfo.Icon))
                                        {
                                            <span class="bi @badgeInfo.Icon me-1"></span>
                                        }
                                        @badgeInfo.Text
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button class="btn btn-outline-secondary rounded-2 me-1" title="Editar campaña" @onclick="() => AbrirModalEditar(promo)">
                                            <span class="bi bi-pencil me-1"></span> Editar
                                        </button>
                                        <button class="btn btn-outline-secondary rounded-2 me-1" title="Duplicar campaña con un nuevo código" @onclick="() => ClonarCampana(promo.Id)">
                                            <span class="bi bi-copy me-1"></span> Clonar
                                        </button>
                                        <button class="btn btn-outline-success rounded-2 me-1" title="Extender vigencia por 7 días" @onclick="() => Extender7Dias(promo.Id)">
                                            <span class="bi bi-calendar-plus me-1"></span> +7 Días
                                        </button>
                                        <button class="btn btn-outline-danger rounded-2 px-2" title="Eliminar campaña" @onclick="() => AbrirModalEliminar(promo)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal para Crear / Editar Promoción -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark font-editorial">
                        <span class="bi bi-tag text-primary me-2"></span>@(promocionActual.Id.HasValue ? "Editar Campaña Promocional" : "Nueva Campaña Promocional")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <!-- Selector de Modalidad: Oferta Directa vs Cupón con Código -->
                        <div class="col-12">
                            <label class="form-label fw-bold text-dark small text-uppercase" style="letter-spacing: 0.05em;">
                                <span class="bi bi-sliders text-primary me-1"></span> Modalidad de la Promoción <span class="text-danger">*</span>
                            </label>
                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <div class="p-3 rounded-2 border h-100 transition-all @(!promocionActual.EsCupon ? "border-primary bg-primary-subtle shadow-2xs" : "bg-light")" 
                                         style="cursor: pointer;" @onclick="() => SeleccionarModalidad(false)">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="radioModoPromo" id="modoAuto" checked="@(!promocionActual.EsCupon)" @onchange="() => SeleccionarModalidad(false)" />
                                            <label class="form-check-label fw-bold text-dark" for="modoAuto" style="cursor: pointer;">
                                                <span class="bi bi-shop text-primary me-1"></span> Descuento Directo en Tienda
                                            </label>
                                        </div>
                                        <small class="text-secondary d-block mt-1 ps-4" style="font-size: 0.8rem; line-height: 1.4;">
                                            Rebaja los libros directamente en el catálogo. Los clientes ya ven el precio rebajado sin tener que escribir ningún código.
                                        </small>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="p-3 rounded-2 border h-100 transition-all @(promocionActual.EsCupon ? "border-warning bg-warning-subtle shadow-2xs" : "bg-light")" 
                                         style="cursor: pointer;" @onclick="() => SeleccionarModalidad(true)">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="radioModoPromo" id="modoCupon" checked="@(promocionActual.EsCupon)" @onchange="() => SeleccionarModalidad(true)" />
                                            <label class="form-check-label fw-bold text-dark" for="modoCupon" style="cursor: pointer;">
                                                <span class="bi bi-ticket-perforated-fill text-warning me-1"></span> Cupón Exclusivo con Código
                                            </label>
                                        </div>
                                        <small class="text-secondary d-block mt-1 ps-4" style="font-size: 0.8rem; line-height: 1.4;">
                                            Solo se activa si el cliente escribe un código secreto en la bolsa de compras (ideal para email marketing o redes).
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Nombre de la Campaña -->
                        <div class="@(promocionActual.EsCupon ? "col-md-6" : "col-12")">
                            <label class="form-label fw-semibold">Nombre de la Campaña <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-2" placeholder="@(!promocionActual.EsCupon ? "Ej. Rebaja de Verano en Libros de Software" : "Ej. Cupón Bienvenida Nuevos Lectores")" @bind="promocionActual.Nombre" maxlength="100" required />
                            <small class="text-muted">Nombre comercial visible para identificar la campaña.</small>
                        </div>

                        <!-- Código de Cupón con Botón Generar (Solo para modalidad Cupón) -->
                        @if (promocionActual.EsCupon)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Código del Cupón <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted font-monospace"><span class="bi bi-ticket-perforated"></span></span>
                                    <input type="text" class="form-control font-monospace text-uppercase fw-bold" placeholder="EJ: LECTURA2026" @bind="promocionActual.CodigoCupon" maxlength="30" required />
                                    <button class="btn btn-outline-primary" type="button" @onclick="GenerarCodigoModal" title="Generar código aleatorio único">
                                        <span class="bi bi-magic me-1"></span> Generar
                                    </button>
                                </div>
                                <small class="text-muted">La palabra o código que el cliente ingresará en el carrito.</small>
                            </div>
                        }

                        <!-- Tipo de Descuento y Valor -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tipo de Descuento <span class="text-danger">*</span></label>
                            <select class="form-select rounded-2" @bind="promocionActual.TipoDescuento">
                                <option value="PORCENTAJE">Porcentaje (%)</option>
                                <option value="MONTO_FIJO">Monto Fijo (S/)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            @if (promocionActual.TipoDescuento == "MONTO_FIJO")
                            {
                                <label class="form-label fw-semibold">Monto de Descuento (S/) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">S/</span>
                                    <input type="number" step="0.50" min="0.50" max="10000" class="form-control" @bind="promocionActual.DescuentoFijo" required />
                                </div>
                            }
                            else
                            {
                                <label class="form-label fw-semibold">Porcentaje de Descuento (%) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">%</span>
                                    <input type="number" class="form-control" min="1" max="100" @bind="promocionActual.PorcentajeDescuento" required />
                                </div>
                            }
                        </div>

                        <!-- Opcionales: Monto Mínimo y Tope Máximo -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Monto Mínimo de Compra (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">S/</span>
                                <input type="number" step="1" min="0" max="10000" class="form-control" placeholder="Ej. 50.00" @bind="promocionActual.MontoMinimoCompra" />
                            </div>
                            <small class="text-muted">Subtotal mínimo en carrito para validar el cupón.</small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tope Máximo de Descuento (Opcional)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">S/</span>
                                <input type="number" step="1" min="0" max="10000" class="form-control" placeholder="Ej. 100.00" @bind="promocionActual.TopeDescuento" />
                            </div>
                            <small class="text-muted">Límite máximo a descontar en caso de porcentajes altos.</small>
                        </div>

                        <!-- Descripción -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Descripción Comercial</label>
                            <textarea class="form-control rounded-2" rows="2" placeholder="Detalles de la campaña de descuento..." @bind="promocionActual.Descripcion" maxlength="300"></textarea>
                        </div>

                        <!-- Cupos y Fechas -->
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cupos Asignados <span class="text-danger">*</span></label>
                            <input type="number" class="form-control rounded-2" min="1" max="10000" @bind="promocionActual.CantidadDefinida" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha de Inicio <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control rounded-2" @bind="promocionActual.FechaInicio" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Fecha de Término <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control rounded-2" @bind="promocionActual.FechaFin" required />
                        </div>

                        <!-- Alcance y Libros -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Alcance y Asignación de Libros <span class="text-danger">*</span></label>
                            <div class="p-3 bg-light rounded-2 border">
                                <div class="d-flex flex-wrap gap-4 mb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="radioAlcance" id="radioGlobal" checked="@esAlcanceGlobal" @onchange="() => CambiarAlcance(true)" />
                                        <label class="form-check-label fw-semibold text-dark" for="radioGlobal">
                                            <span class="bi bi-globe me-1 text-primary"></span> Catálogo Completo (Aplica a todos los libros)
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="radioAlcance" id="radioEspecificos" checked="@(!esAlcanceGlobal)" @onchange="() => CambiarAlcance(false)" />
                                        <label class="form-check-label fw-semibold text-dark" for="radioEspecificos">
                                            <span class="bi bi-book me-1 text-success"></span> Libros Específicos (Seleccionar títulos)
                                        </label>
                                    </div>
                                </div>

                                @if (!esAlcanceGlobal)
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                            <span class="small fw-bold text-secondary">
                                                Títulos seleccionados: <span class="badge bg-primary rounded-pill px-2 py-1">@librosSeleccionadosIds.Count</span>
                                            </span>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-2 px-2 py-1" @onclick="SeleccionarTodosLibros">
                                                    <span class="bi bi-check-all me-1"></span> Marcar Todos
                                                </button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1" @onclick="DeseleccionarTodosLibros">
                                                    <span class="bi bi-x me-1"></span> Limpiar
                                                </button>
                                            </div>
                                        </div>

                                        <div class="input-group input-group-sm mb-2">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Filtrar por título, autor o ISBN..." @bind="filtroLibrosModal" @bind:event="oninput" />
                                        </div>

                                        <div class="border rounded-2 p-2 bg-white" style="max-height: 220px; overflow-y: auto;">
                                            @if (catalogoLibrosFiltrados.Count == 0)
                                            {
                                                <div class="text-center text-muted py-3 small">
                                                    No se encontraron libros que coincidan con la búsqueda.
                                                </div>
                                            }
                                            else
                                            {
                                                @foreach (var libro in catalogoLibrosFiltrados)
                                                {
                                                    var isChecked = libro.Id.HasValue && librosSeleccionadosIds.Contains(libro.Id.Value);
                                                    <div class="form-check py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                                                        <div class="d-flex align-items-center">
                                                            <input class="form-check-input me-3" type="checkbox" id="chkLibro_@libro.Id" checked="@isChecked" @onchange="() => ToggleLibroSeleccion(libro.Id)" />
                                                            <label class="form-check-label mb-0" for="chkLibro_@libro.Id" style="cursor: pointer;">
                                                                <span class="fw-semibold text-dark font-editorial">@libro.Titulo</span>
                                                                <span class="text-muted small ms-2 d-block d-md-inline">• @libro.AutorPrincipal</span>
                                                            </label>
                                                        </div>
                                                        <span class="badge bg-light text-primary border fw-bold ms-2">S/ @libro.Precio.ToString("N2")</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Estado Habilitado -->
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="chkPromoActiva" @bind="promocionActual.Activo" />
                                <label class="form-check-label fw-semibold" for="chkPromoActiva">Campaña habilitada y disponible para clientes</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-2 px-4" @onclick="GuardarPromocion">
                        <span class="bi bi-save me-1"></span> Guardar Campaña
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación para Eliminar Promoción -->
@if (mostrarModalEliminar && promocionParaEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3 bg-light">
                    <h5 class="modal-title fw-bold text-danger font-editorial">
                        <span class="bi bi-exclamation-triangle-fill me-2"></span>Confirmar Eliminación
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body p-4 text-center">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-3 mb-3">
                        <span class="bi bi-trash fs-2"></span>
                    </div>
                    <h5 class="fw-bold text-dark font-editorial mb-2">¿Eliminar campaña comercial?</h5>
                    <p class="text-muted mb-3">
                        Estás a punto de eliminar permanentemente la campaña:
                    </p>
                    <div class="p-3 bg-light rounded-2 border text-start mb-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <code class="fw-bold text-dark font-monospace">@promocionParaEliminar.CodigoCupon</code>
                            <span class="fw-bold text-dark font-editorial">@promocionParaEliminar.Nombre</span>
                        </div>
                        <div class="text-muted small">
                            Descuento: @(promocionParaEliminar.EsMontoFijo ? $"S/ {promocionParaEliminar.DescuentoFijo:N2}" : $"{promocionParaEliminar.PorcentajeDescuento:0}%") | Cupos: @promocionParaEliminar.CantidadDisponible / @promocionParaEliminar.CantidadDefinida
                        </div>
                    </div>
                    <div class="alert alert-warning small text-start py-2 mb-0">
                        <span class="bi bi-info-circle me-1"></span> Esta acción no se puede deshacer. Los cupones no canjeados dejarán de ser válidos inmediatamente.
                    </div>
                </div>
                <div class="modal-footer border-top py-3 justify-content-center">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-4" @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger rounded-2 px-4" @onclick="EjecutarEliminar">
                        <span class="bi bi-trash me-1"></span> Sí, Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PromocionDto> promociones = new();
    private List<LibroDto> catalogoLibros = new();
    private HashSet<long> librosSeleccionadosIds = new();
    private bool esAlcanceGlobal = true;
    private string filtroLibrosModal = "";
    private PromocionDto promocionActual = new();
    private PromocionDto? promocionParaEliminar = null;
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private string busquedaTexto = "";
    private string filtroEstado = "TODAS";
    private string? mensajeExito = null;
    private string? mensajeError = null;

    private int TotalAlertas => promociones.Count(p => p.EsVigente && (p.DiasRestantes <= 3 || (p.CantidadDefinida > 0 && (p.CantidadDisponible * 100 / p.CantidadDefinida) <= 10)));

    private List<PromocionDto> promocionesFiltradas => promociones
        .Where(p => filtroEstado switch
        {
            "VIGENTES" => p.EsVigente,
            "POR_VENCER" => p.EsVigente && (p.DiasRestantes <= 3 || (p.CantidadDefinida > 0 && (p.CantidadDisponible * 100 / p.CantidadDefinida) <= 10)),
            "PROGRAMADAS" => p.EsProgramada,
            "VENCIDAS_AGOTADAS" => !p.EsVigente && !p.EsProgramada,
            _ => true
        })
        .Where(p => string.IsNullOrWhiteSpace(busquedaTexto) ||
                    (p.CodigoCupon != null && p.CodigoCupon.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Nombre != null && p.Nombre.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase)) ||
                    (p.Descripcion != null && p.Descripcion.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private List<LibroDto> catalogoLibrosFiltrados =>
        string.IsNullOrWhiteSpace(filtroLibrosModal)
            ? catalogoLibros
            : catalogoLibros.Where(l =>
                l.Titulo.Contains(filtroLibrosModal, StringComparison.OrdinalIgnoreCase) ||
                l.AutorPrincipal.Contains(filtroLibrosModal, StringComparison.OrdinalIgnoreCase) ||
                (l.Isbn?.Contains(filtroLibrosModal, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarPromociones();
        try
        {
            catalogoLibros = await LibroService.GetAll();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al precargar libros en promociones: {ex.Message}");
        }
    }

    private async Task CargarPromociones()
    {
        cargando = true;
        try
        {
            promociones = await PromocionService.GetAll();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar promociones: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private (string Text, string BadgeClass, string Icon) ObtenerBadgeEstado(PromocionDto promo)
    {
        var estado = promo.EstadoCalculado;
        return estado switch
        {
            "PROGRAMADA" => ("Programada", "badge bg-primary-subtle text-primary border border-primary-subtle", "bi-calendar-event"),
            "POR_VENCER" => ("⏳ Por vencer", "badge bg-warning-subtle text-warning-emphasis border border-warning-subtle", ""),
            "VIGENTE" => ("Vigente", "badge bg-success-subtle text-success border border-success-subtle", "bi-check-circle-fill"),
            "AGOTADA" => ("Agotada", "badge bg-danger-subtle text-danger border border-danger-subtle", "bi-dash-circle"),
            "EXPIRADA" => ("Expirada", "badge bg-secondary-subtle text-muted border border-secondary-subtle", "bi-clock-history"),
            _ => (!promo.Activo
                ? ("Inactiva", "badge bg-secondary-subtle text-muted border border-secondary-subtle", "bi-pause-circle")
                : ("Expirada", "badge bg-secondary-subtle text-muted border border-secondary-subtle", "bi-clock-history"))
        };
    }

    private void CambiarAlcance(bool global)
    {
        esAlcanceGlobal = global;
        if (global)
        {
            librosSeleccionadosIds.Clear();
        }
    }

    private void ToggleLibroSeleccion(long? libroId)
    {
        if (!libroId.HasValue) return;
        if (librosSeleccionadosIds.Contains(libroId.Value))
        {
            librosSeleccionadosIds.Remove(libroId.Value);
        }
        else
        {
            librosSeleccionadosIds.Add(libroId.Value);
        }
    }

    private void SeleccionarTodosLibros()
    {
        foreach (var libro in catalogoLibros)
        {
            if (libro.Id.HasValue)
            {
                librosSeleccionadosIds.Add(libro.Id.Value);
            }
        }
    }

    private void DeseleccionarTodosLibros()
    {
        librosSeleccionadosIds.Clear();
    }

    private void GenerarCodigoModal()
    {
        promocionActual.CodigoCupon = PromocionService.GenerarCodigoUnico();
    }

    private void SeleccionarModalidad(bool esCupon)
    {
        promocionActual.EsCupon = esCupon;
        if (esCupon && string.IsNullOrWhiteSpace(promocionActual.CodigoCupon))
        {
            promocionActual.CodigoCupon = PromocionService.GenerarCodigoUnico();
        }
    }

    private void AbrirModalNuevaPromocion()
    {
        mensajeExito = null;
        mensajeError = null;
        var hoy = DateTime.Now;
        promocionActual = new PromocionDto
        {
            Nombre = "Descuento en Libros Seleccionados",
            EsCupon = false,
            CodigoCupon = "",
            TipoDescuento = "PORCENTAJE",
            PorcentajeDescuento = 20,
            DescuentoFijo = 10m,
            CantidadDefinida = 100,
            CantidadDisponible = 100,
            FechaInicio = hoy,
            FechaFin = hoy.AddMonths(1),
            Activo = true,
            Libroses = new()
        };
        librosSeleccionadosIds.Clear();
        esAlcanceGlobal = true;
        filtroLibrosModal = "";
        mostrarModal = true;
    }

    private void AbrirModalEditar(PromocionDto promo)
    {
        mensajeExito = null;
        mensajeError = null;
        promocionActual = new PromocionDto
        {
            Id = promo.Id,
            Nombre = promo.Nombre,
            EsCupon = promo.EsCupon,
            CodigoCupon = promo.CodigoCupon,
            Descripcion = promo.Descripcion,
            TipoDescuento = promo.TipoDescuento ?? (promo.EsMontoFijo ? "MONTO_FIJO" : "PORCENTAJE"),
            PorcentajeDescuento = promo.PorcentajeDescuento,
            DescuentoFijo = promo.DescuentoFijo,
            MontoMinimoCompra = promo.MontoMinimoCompra,
            TopeDescuento = promo.TopeDescuento,
            CantidadDefinida = promo.CantidadDefinida,
            CantidadDisponible = promo.CantidadDisponible,
            FechaInicio = promo.FechaInicio.Kind == DateTimeKind.Utc ? promo.FechaInicio.ToLocalTime() : promo.FechaInicio,
            FechaFin = promo.FechaFin.Kind == DateTimeKind.Utc ? promo.FechaFin.ToLocalTime() : promo.FechaFin,
            Activo = promo.Activo,
            Libroses = new List<LibroDto>(promo.Libroses ?? new())
        };

        librosSeleccionadosIds = new HashSet<long>(
            promo.Libroses?.Where(l => l.Id.HasValue).Select(l => l.Id!.Value) ?? Enumerable.Empty<long>()
        );
        esAlcanceGlobal = librosSeleccionadosIds.Count == 0;
        filtroLibrosModal = "";
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarPromocion()
    {
        mensajeError = null;
        var nombreLimpio = (promocionActual.Nombre ?? "").Trim();
        var codigoLimpio = (promocionActual.CodigoCupon ?? "").Trim().ToUpperInvariant();

        if (string.IsNullOrWhiteSpace(nombreLimpio) || nombreLimpio.Length < 3 || nombreLimpio.Length > 100)
        {
            mensajeError = "El nombre de la campaña debe tener entre 3 y 100 caracteres.";
            return;
        }

        if (promocionActual.EsCupon)
        {
            if (string.IsNullOrWhiteSpace(codigoLimpio) || codigoLimpio.Length < 3 || codigoLimpio.Length > 30)
            {
                mensajeError = "Para un cupón, el código es obligatorio y debe tener entre 3 y 30 caracteres.";
                return;
            }
        }
        else
        {
            if (string.IsNullOrWhiteSpace(codigoLimpio))
            {
                codigoLimpio = "";
            }
        }

        if (promocionActual.TipoDescuento == "MONTO_FIJO")
        {
            if (promocionActual.DescuentoFijo <= 0m || promocionActual.DescuentoFijo > 10000m)
            {
                mensajeError = "El monto fijo de descuento debe ser mayor a S/ 0 y menor a S/ 10,000.";
                return;
            }
        }
        else
        {
            if (promocionActual.PorcentajeDescuento < 1 || promocionActual.PorcentajeDescuento > 100)
            {
                mensajeError = "El porcentaje de descuento debe situarse entre 1% y 100%.";
                return;
            }
        }

        if (promocionActual.MontoMinimoCompra.HasValue && promocionActual.MontoMinimoCompra.Value < 0)
        {
            mensajeError = "El monto mínimo de compra no puede ser un valor negativo.";
            return;
        }

        if (promocionActual.TopeDescuento.HasValue && promocionActual.TopeDescuento.Value < 0)
        {
            mensajeError = "El tope de descuento no puede ser un valor negativo.";
            return;
        }

        if (promocionActual.CantidadDefinida < 1 || promocionActual.CantidadDefinida > 10000)
        {
            mensajeError = "La cantidad de cupos debe encontrarse entre 1 y 10,000.";
            return;
        }

        if (promocionActual.FechaFin < promocionActual.FechaInicio)
        {
            mensajeError = "La fecha de término no puede ser anterior a la fecha de inicio.";
            return;
        }

        if (promocionActual.FechaFin.TimeOfDay == TimeSpan.Zero || promocionActual.FechaFin.Date == promocionActual.FechaInicio.Date)
        {
            promocionActual.FechaFin = promocionActual.FechaFin.Date.AddDays(1).AddTicks(-1);
        }

        if (!esAlcanceGlobal && librosSeleccionadosIds.Count == 0)
        {
            mensajeError = "Debes seleccionar al menos un libro para una campaña con alcance específico.";
            return;
        }

        promocionActual.Nombre = nombreLimpio;
        promocionActual.CodigoCupon = codigoLimpio;

        if (esAlcanceGlobal)
        {
            promocionActual.Libroses = new List<LibroDto>();
        }
        else
        {
            promocionActual.Libroses = catalogoLibros
                .Where(l => l.Id.HasValue && librosSeleccionadosIds.Contains(l.Id.Value))
                .ToList();
        }

        bool exito;
        if (promocionActual.Id.HasValue)
        {
            exito = await PromocionService.Editar(promocionActual);
        }
        else
        {
            promocionActual.CantidadDisponible = promocionActual.CantidadDefinida;
            exito = await PromocionService.Crear(promocionActual);
        }

        if (exito)
        {
            foreach (var libro in catalogoLibros)
            {
                if (!libro.Id.HasValue) continue;
                libro.Promociones.RemoveAll(p => p.Id == promocionActual.Id);
                if (!esAlcanceGlobal && librosSeleccionadosIds.Contains(libro.Id.Value))
                {
                    libro.Promociones.Add(promocionActual);
                }
            }

            mensajeExito = $"Campaña '{promocionActual.Nombre}' (Código: {promocionActual.CodigoCupon}) guardada correctamente.";
            mostrarModal = false;
            await CargarPromociones();
        }
        else
        {
            mensajeError = "No se pudo guardar la campaña comercial en el servidor.";
        }
    }

    private async Task ClonarCampana(long? id)
    {
        if (!id.HasValue) return;
        cargando = true;
        mensajeExito = null;
        mensajeError = null;
        try
        {
            var exito = await PromocionService.Clonar(id.Value);
            if (exito)
            {
                mensajeExito = "Campaña clonada exitosamente con un nuevo código de cupón.";
                await CargarPromociones();
            }
            else
            {
                mensajeError = "No se pudo clonar la campaña.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al clonar campaña: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Extender7Dias(long? id)
    {
        if (!id.HasValue) return;
        cargando = true;
        mensajeExito = null;
        mensajeError = null;
        try
        {
            var exito = await PromocionService.ExtenderDias(id.Value, 7);
            if (exito)
            {
                mensajeExito = "Vigencia de la campaña extendida exitosamente por +7 días.";
                await CargarPromociones();
            }
            else
            {
                mensajeError = "No se pudo extender la vigencia de la campaña.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al extender vigencia: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalEliminar(PromocionDto promo)
    {
        promocionParaEliminar = promo;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        promocionParaEliminar = null;
    }

    private async Task EjecutarEliminar()
    {
        if (promocionParaEliminar?.Id == null) return;
        var nombre = promocionParaEliminar.Nombre;
        var codigo = promocionParaEliminar.CodigoCupon;
        var id = promocionParaEliminar.Id.Value;
        CerrarModalEliminar();

        mensajeExito = null;
        mensajeError = null;
        var exito = await PromocionService.Eliminar(id);
        if (exito)
        {
            mensajeExito = $"Campaña '{nombre}' ({codigo}) eliminada con éxito.";
            await CargarPromociones();
        }
        else
        {
            mensajeError = "Error al intentar eliminar la campaña del servidor.";
        }
    }
}
