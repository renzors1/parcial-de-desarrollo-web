@page "/admin/licencias"
@rendermode InteractiveServer
@inject LicenciaDigitalService LicenciaService
@inject LibroService LibroService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Administración de Licencias DRM</PageTitle>

<div class="container my-4">
    <!-- Encabezado con Botón de Creación -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2 fw-bold mb-1 text-dark font-editorial">Licencias Digitales y Claves DRM</h1>
            <p class="text-muted mb-0">Gestión de claves de activación, licencias disponibles y asignaciones comerciales</p>
        </div>
        <button class="btn btn-primary rounded-2 px-3 shadow-2xs" @onclick="AbrirModalNuevaLicencia">
            <span class="bi bi-key me-1"></span> Nueva Clave DRM
        </button>
    </div>

    @if (!TokenService.IsAuthenticated)
    {
        <div class="alert alert-warning rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-shield-lock me-2"></span>
            <strong>Aviso:</strong> Inicia sesión como administrador para disponer de autorización completa.
        </div>
    }

    @if (mensajeAlerta != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
            <span class="bi bi-info-circle-fill me-2"></span> @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    <!-- Tarjetas de Métricas -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-primary border p-3 me-3">
                        <span class="bi bi-key fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Registradas</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@licencias.Count</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-success-subtle text-success border border-success-subtle p-3 me-3">
                        <span class="bi bi-check-circle fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Disponibles</span>
                        <h3 class="fw-bold text-success mb-0 font-editorial">@licencias.Count(l => l.Estado == "DISPONIBLE")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-info border p-3 me-3">
                        <span class="bi bi-person-check fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Asignadas a Clientes</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">@licencias.Count(l => l.Estado == "VENDIDA")</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border shadow-2xs rounded-2 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="rounded-2 bg-light text-warning border p-3 me-3">
                        <span class="bi bi-pie-chart fs-4"></span>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Asignación %</span>
                        <h3 class="fw-bold text-dark mb-0 font-editorial">
                            @(licencias.Count > 0 ? (licencias.Count(l => l.Estado == "VENDIDA") * 100 / licencias.Count) : 0)%
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card border shadow-2xs rounded-2 p-3 bg-white mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><span class="bi bi-search"></span></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por código, título de libro o cliente..." @bind="busquedaTexto" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-12 col-md-6 d-flex justify-content-md-end gap-2">
                <div class="btn-group" role="group">
                    <button class="btn btn-sm @(filtroEstado == "TODOS" ? "btn-primary" : "btn-outline-secondary") rounded-2 px-3 me-1" @onclick='() => filtroEstado = "TODOS"'>Todas</button>
                    <button class="btn btn-sm @(filtroEstado == "DISPONIBLE" ? "btn-success" : "btn-outline-secondary") rounded-2 px-3 me-1" @onclick='() => filtroEstado = "DISPONIBLE"'>Disponibles</button>
                    <button class="btn btn-sm @(filtroEstado == "VENDIDA" ? "btn-primary" : "btn-outline-secondary") rounded-2 px-3" @onclick='() => filtroEstado = "VENDIDA"'>Asignadas</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Licencias -->
    @if (cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando licencias...</p>
        </div>
    }
    else if (licenciasFiltradas.Count == 0)
    {
        <div class="card border shadow-2xs rounded-2 p-5 text-center bg-white">
            <span class="bi bi-key text-muted display-4"></span>
            <h4 class="mt-3 text-dark">No se encontraron licencias</h4>
            <p class="text-muted">No existen licencias con el criterio de búsqueda seleccionado.</p>
        </div>
    }
    else
    {
        <div class="card border shadow-2xs rounded-2 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Clave DRM</th>
                            <th>Título Asociado</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Usuario / Titular</th>
                            <th class="text-end pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lic in licenciasFiltradas)
                        {
                            <tr>
                                <td class="ps-4 text-muted small">@lic.Id</td>
                                <td>
                                    <code class="fw-bold text-dark">@lic.CodigoLicencia</code>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark font-editorial">@(lic.Libro?.Titulo ?? "Libro General")</div>
                                    <small class="text-muted">ISBN: @(lic.Libro?.Isbn ?? "N/A")</small>
                                </td>
                                <td>
                                    @if (lic.Estado == "DISPONIBLE")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-2 px-2 py-1">
                                            <span class="bi bi-check-circle me-1"></span> DISPONIBLE
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-2 px-2 py-1">
                                            <span class="bi bi-person-fill me-1"></span> ASIGNADA
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="d-block small text-dark">
                                        @(lic.FechaAsignacion?.ToString("dd/MM/yyyy HH:mm") ?? lic.FechaCreacion?.ToString("dd/MM/yyyy HH:mm") ?? "Reciente")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">
                                        @(lic.UsuarioCreacion ?? "admin")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-danger rounded-2 px-2 py-1" title="Eliminar Licencia" @onclick="() => SolicitarEliminarLicencia(lic)">
                                        <span class="bi bi-trash"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal para Crear Nueva Licencia Digital -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark font-editorial">
                        <span class="bi bi-key text-primary me-2"></span>Registrar Nueva Clave DRM
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Título del Catálogo</label>
                        <select class="form-select rounded-2" @bind="libroSeleccionadoId">
                            @foreach (var l in catalogoLibros)
                            {
                                <option value="@l.Id">@l.Titulo (ISBN: @l.Isbn)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Código / Clave DRM <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" @onclick="GenerarCodigoAleatorio">
                                <span class="bi bi-arrow-repeat me-1"></span> Generar aleatorio
                            </button>
                        </div>
                        <input type="text" class="form-control rounded-2 font-monospace" @bind="nuevaLicencia.CodigoLicencia" maxlength="50" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Enlace de Acceso / Visor</label>
                        <input type="text" class="form-control rounded-2" @bind="nuevaLicencia.EnlaceDescarga" maxlength="500" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estado Inicial</label>
                        <select class="form-select rounded-2" @bind="nuevaLicencia.Estado">
                            <option value="DISPONIBLE">DISPONIBLE (Para asignación comercial)</option>
                            <option value="VENDIDA">ASIGNADA / VENDIDA</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary rounded-2 px-4" @onclick="GuardarLicencia">Guardar Licencia</button>
                </div>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminar && licenciaAEliminar != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2 border shadow">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark font-editorial">
                        <span class="bi bi-exclamation-triangle-fill text-danger me-2"></span> Confirmar Eliminación de Licencia
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-secondary mb-3">
                        ¿Estás seguro de que deseas eliminar permanentemente la siguiente licencia digital DRM?
                    </p>
                    <div class="p-3 bg-light rounded-2 border mb-3">
                        <div class="fw-bold text-dark mb-1"><code>@licenciaAEliminar.CodigoLicencia</code></div>
                        <div class="small text-muted font-editorial">Obra: @(licenciaAEliminar.Libro?.Titulo ?? "Libro General")</div>
                        <div class="small text-secondary mt-1">
                            Estado: <span class="badge @(licenciaAEliminar.Estado == "DISPONIBLE" ? "bg-success" : "bg-primary")">@licenciaAEliminar.Estado</span>
                            • Titular: @(licenciaAEliminar.UsuarioCreacion ?? "admin")
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        Esta acción invalidará el acceso a la lectura digital asociado a esta clave.
                    </p>
                </div>
                <div class="modal-footer border-top py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-2 px-3" @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger rounded-2 px-4 fw-semibold" @onclick="ConfirmarEliminarLicencia">
                        <span class="bi bi-trash me-1"></span> Sí, Eliminar Licencia
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LicenciaDigitalDto> licencias = new();
    private List<LibroDto> catalogoLibros = new();
    private LicenciaDigitalDto nuevaLicencia = new();
    private LicenciaDigitalDto? licenciaAEliminar = null;
    private long libroSeleccionadoId = 0;
    private bool cargando = true;
    private bool mostrarModal = false;
    private bool mostrarModalEliminar = false;
    private string busquedaTexto = "";
    private string filtroEstado = "TODOS";
    private string? mensajeAlerta = null;

    private List<LicenciaDigitalDto> licenciasFiltradas => licencias
        .Where(l => filtroEstado == "TODOS" || l.Estado == filtroEstado)
        .Where(l => string.IsNullOrWhiteSpace(busquedaTexto) ||
                    l.CodigoLicencia.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase) ||
                    (l.Libro?.Titulo?.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (l.UsuarioCreacion?.Contains(busquedaTexto, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            licencias = await LicenciaService.GetAll();
            catalogoLibros = await LibroService.GetAll();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar licencias: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevaLicencia()
    {
        nuevaLicencia = new LicenciaDigitalDto
        {
            Estado = "DISPONIBLE",
            FechaCreacion = DateTime.UtcNow
        };
        GenerarCodigoAleatorio();
        if (catalogoLibros.Count > 0)
        {
            libroSeleccionadoId = catalogoLibros[0].Id ?? 0;
            nuevaLicencia.EnlaceDescarga = $"https://visor.bookstore.com/read/{libroSeleccionadoId}";
        }
        mostrarModal = true;
    }

    private void GenerarCodigoAleatorio()
    {
        nuevaLicencia.CodigoLicencia = $"LIC-{DateTime.UtcNow.Year}-{Guid.NewGuid().ToString("N")[..8].ToUpper()}";
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarLicencia()
    {
        var codigoLimpio = (nuevaLicencia.CodigoLicencia ?? "").Trim();
        if (string.IsNullOrWhiteSpace(codigoLimpio) || codigoLimpio.Length < 5 || codigoLimpio.Length > 50)
        {
            mensajeAlerta = "Error: El código de licencia debe tener entre 5 y 50 caracteres.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(nuevaLicencia.EnlaceDescarga) && nuevaLicencia.EnlaceDescarga.Length > 500)
        {
            mensajeAlerta = "Error: El enlace de descarga no puede superar los 500 caracteres.";
            return;
        }

        nuevaLicencia.CodigoLicencia = codigoLimpio;

        var libro = catalogoLibros.FirstOrDefault(l => l.Id == libroSeleccionadoId);
        nuevaLicencia.Libro = libro;

        if (string.IsNullOrWhiteSpace(nuevaLicencia.EnlaceDescarga))
        {
            nuevaLicencia.EnlaceDescarga = $"https://visor.bookstore.com/read/{libroSeleccionadoId}";
        }

        var exito = await LicenciaService.Crear(nuevaLicencia);
        if (exito)
        {
            mensajeAlerta = $"Licencia '{nuevaLicencia.CodigoLicencia}' creada con éxito.";
            mostrarModal = false;
            await CargarDatos();
        }
        else
        {
            mensajeAlerta = "No se pudo crear la licencia. Revisa la conexión.";
        }
    }

    private void SolicitarEliminarLicencia(LicenciaDigitalDto lic)
    {
        licenciaAEliminar = lic;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        licenciaAEliminar = null;
        mostrarModalEliminar = false;
    }

    private async Task ConfirmarEliminarLicencia()
    {
        if (licenciaAEliminar?.Id.HasValue == true)
        {
            var exito = await LicenciaService.Eliminar(licenciaAEliminar.Id.Value);
            if (exito)
            {
                mensajeAlerta = $"Licencia '{licenciaAEliminar.CodigoLicencia}' eliminada correctamente.";
                CerrarModalEliminar();
                await CargarDatos();
            }
            else
            {
                mensajeAlerta = "Error al intentar eliminar la licencia.";
            }
        }
    }
}
