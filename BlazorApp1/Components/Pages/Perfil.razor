@page "/perfil"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenService TokenService
@inject LicenciaDigitalService LicenciaService
@inject CalificacionService CalificacionService
@inject NavigationManager Navigation

<PageTitle>Mi Perfil - BookStore</PageTitle>

<div class="container my-4">
    <!-- Encabezado de Perfil -->
    <div class="p-4 p-md-5 mb-4 rounded-2 text-white shadow-sm" style="background-color: #0f172a; border-left: 4px solid #3b82f6;">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-1 rounded-2 mb-2 text-uppercase fw-semibold" style="letter-spacing: 0.05em;">
                    <span class="bi bi-person-badge me-1"></span> Cuenta de Usuario
                </span>
                <h1 class="display-6 fw-bold mb-2 font-editorial text-white">Mi Perfil y Preferencias</h1>
                <p class="fs-5 text-light opacity-75 mb-0 font-editorial">
                    Administra tus datos personales, información de acceso y revisa tus obras adquiridas.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <a href="/mis-libros" class="btn btn-outline-light px-4 py-2 rounded-2">
                    <span class="bi bi-journal-bookmark me-2"></span> Mis Libros Digitales
                </a>
            </div>
        </div>
    </div>

    @if (!TokenService.IsAuthenticated)
    {
        <div class="card border shadow-sm rounded-2 p-5 text-center my-4 bg-white">
            <div class="text-primary display-3 mb-3">
                <span class="bi bi-shield-lock"></span>
            </div>
            <h3 class="fw-bold text-dark font-editorial">Inicia sesión para gestionar tu perfil</h3>
            <p class="text-muted col-md-6 mx-auto">
                Para ver y actualizar tu información personal de cliente o cambiar tu contraseña, necesitas identificarte con tu cuenta.
            </p>
            <div class="mt-3 d-flex justify-content-center gap-3">
                <a href="/login" class="btn btn-primary rounded-2 px-4 py-2 fw-semibold">
                    <span class="bi bi-box-arrow-in-right me-1"></span> Iniciar Sesión
                </a>
                <a href="/registro" class="btn btn-outline-secondary rounded-2 px-4 py-2">
                    <span class="bi bi-person-plus me-1"></span> Registrarme
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Columna Izquierda: Tarjeta Resumen de Perfil -->
            <div class="col-12 col-lg-4">
                <div class="card border shadow-sm rounded-2 p-4 bg-white text-center mb-4">
                    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary border border-primary-subtle" style="width: 90px; height: 90px; font-size: 2.2rem; font-weight: 700;">
                        @InicialesUsuario
                    </div>

                    <h4 class="fw-bold text-dark mb-1 font-editorial">@NombreCompleto</h4>
                    <p class="text-muted small mb-2">@@@perfilModel.Login</p>

                    <div class="mb-3">
                        @if (TokenService.IsAdmin)
                        {
                            <span class="badge bg-warning text-dark border px-3 py-2 rounded-2 fw-semibold">
                                <span class="bi bi-shield-check me-1"></span> Administrador Editorial
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary text-white border px-3 py-2 rounded-2 fw-semibold">
                                <span class="bi bi-person-check me-1"></span> Cliente Lector
                            </span>
                        }
                    </div>

                    <hr class="opacity-25 my-3" />

                    <!-- Métricas Rápidas del Cliente -->
                    <div class="row g-2 text-start">
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-2 border d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="small text-muted d-block">Licencias Digitales DRM</span>
                                    <strong class="text-dark fs-5 font-editorial">@totalLicencias</strong>
                                </div>
                                <a href="/mis-libros" class="btn btn-sm btn-outline-primary rounded-2">
                                    Ver libros
                                </a>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-2 border d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="small text-muted d-block">Reseñas Registradas</span>
                                    <strong class="text-dark fs-5 font-editorial">@totalResenas</strong>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    Lector Activo
                                </span>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-2 border">
                                <span class="small text-muted d-block">Correo Registrado</span>
                                <span class="text-dark fw-semibold small text-truncate d-block">@perfilModel.Email</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Formularios de Edición y Seguridad -->
            <div class="col-12 col-lg-8">
                <!-- Alertas de Estado -->
                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
                        <span class="bi bi-check-circle-fill me-2"></span> @mensajeExito
                        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-2 shadow-2xs mb-4" role="alert">
                        <span class="bi bi-exclamation-triangle-fill me-2"></span> @mensajeError
                        <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
                    </div>
                }

                <!-- Tarjeta 1: Información Personal -->
                <div class="card border shadow-sm rounded-2 p-4 p-md-4 bg-white mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="bi bi-person-lines-fill text-primary fs-4 me-2"></span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0 font-editorial">Información Personal</h5>
                            <small class="text-muted">Actualiza tus nombres, apellidos y dirección de correo</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Nombres <span class="text-danger">*</span></label>
                            <input type="text" class="form-control rounded-2 fs-6" placeholder="Tus nombres" @bind="perfilModel.FirstName" maxlength="50" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Apellidos</label>
                            <input type="text" class="form-control rounded-2 fs-6" placeholder="Tus apellidos" @bind="perfilModel.LastName" maxlength="50" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Correo Electrónico <span class="text-danger">*</span></label>
                            <input type="email" class="form-control rounded-2 fs-6" placeholder="correo@ejemplo.com" @bind="perfilModel.Email" maxlength="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Nombre de Usuario (Login)</label>
                            <input type="text" class="form-control rounded-2 fs-6 bg-light text-muted" value="@perfilModel.Login" disabled readonly />
                            <small class="text-muted" style="font-size: 0.75rem;">El nombre de usuario es único y permanente.</small>
                        </div>

                        <div class="col-12 pt-2 text-end">
                            <button type="button" class="btn btn-primary rounded-2 px-4 fw-semibold shadow-2xs" disabled="@guardandoPerfil" @onclick="GuardarPerfil">
                                @if (guardandoPerfil)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <span class="bi bi-save me-1"></span> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Tarjeta 2: Seguridad y Contraseña -->
                <div class="card border shadow-sm rounded-2 p-4 p-md-4 bg-white mb-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="bi bi-shield-lock text-primary fs-4 me-2"></span>
                        <div>
                            <h5 class="fw-bold text-dark mb-0 font-editorial">Seguridad y Contraseña</h5>
                            <small class="text-muted">Actualiza tu clave de acceso a la librería digital</small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Contraseña Actual <span class="text-danger">*</span></label>
                            <input type="password" class="form-control rounded-2 fs-6" placeholder="Tu contraseña actual" @bind="passwordActual" maxlength="100" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Nueva Contraseña <span class="text-danger">*</span></label>
                            <input type="password" class="form-control rounded-2 fs-6" placeholder="Mínimo 4 caracteres" @bind="passwordNuevo" maxlength="100" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Confirmar Contraseña <span class="text-danger">*</span></label>
                            <input type="password" class="form-control rounded-2 fs-6" placeholder="Repite la nueva clave" @bind="passwordConfirmacion" maxlength="100" />
                        </div>

                        <div class="col-12 pt-2 text-end">
                            <button type="button" class="btn btn-outline-primary rounded-2 px-4 fw-semibold" disabled="@cambiandoPassword" @onclick="CambiarPassword">
                                @if (cambiandoPassword)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <span class="bi bi-key me-1"></span> Actualizar Contraseña
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private UserAccountDto perfilModel = new();
    private string passwordActual = "";
    private string passwordNuevo = "";
    private string passwordConfirmacion = "";
    private bool guardandoPerfil = false;
    private bool cambiandoPassword = false;
    private string? mensajeExito = null;
    private string? mensajeError = null;
    private int totalLicencias = 0;
    private int totalResenas = 0;

    private string NombreCompleto =>
        string.IsNullOrWhiteSpace($"{perfilModel.FirstName} {perfilModel.LastName}".Trim())
            ? (perfilModel.Login ?? "Lector")
            : $"{perfilModel.FirstName} {perfilModel.LastName}".Trim();

    private string InicialesUsuario
    {
        get
        {
            var f = (perfilModel.FirstName ?? perfilModel.Login ?? "U").Trim();
            var l = (perfilModel.LastName ?? "").Trim();
            if (!string.IsNullOrWhiteSpace(f) && !string.IsNullOrWhiteSpace(l))
            {
                return $"{f[0]}{l[0]}".ToUpper();
            }
            return (f.Length > 0 ? f[0].ToString() : "U").ToUpper();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (TokenService.IsAuthenticated && TokenService.CurrentUser != null)
        {
            var user = TokenService.CurrentUser;
            perfilModel = new UserAccountDto
            {
                Id = user.Id,
                Login = user.Login,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email,
                Authorities = new List<string>(user.Authorities)
            };

            await CargarEstadisticas();
        }
    }

    private async Task CargarEstadisticas()
    {
        try
        {
            var lics = await LicenciaService.GetMisLicencias();
            totalLicencias = lics.Count;
        }
        catch { }

        try
        {
            var todasResenas = await CalificacionService.GetAll();
            var login = perfilModel.Login;
            totalResenas = todasResenas.Count(r => string.Equals(r.UsuarioCreacion, login, StringComparison.OrdinalIgnoreCase));
        }
        catch { }
    }

    private async Task GuardarPerfil()
    {
        mensajeExito = null;
        mensajeError = null;
        guardandoPerfil = true;

        try
        {
            var (exito, error) = await AuthService.ActualizarPerfilAsync(perfilModel);
            if (exito)
            {
                mensajeExito = "¡Tus datos de perfil han sido actualizados correctamente!";
            }
            else
            {
                mensajeError = error ?? "No se pudieron actualizar los datos del perfil.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al guardar cambios: {ex.Message}";
        }
        finally
        {
            guardandoPerfil = false;
        }
    }

    private async Task CambiarPassword()
    {
        mensajeExito = null;
        mensajeError = null;

        if (string.IsNullOrWhiteSpace(passwordActual))
        {
            mensajeError = "Debes ingresar tu contraseña actual.";
            return;
        }

        if (string.IsNullOrWhiteSpace(passwordNuevo) || passwordNuevo.Length < 4)
        {
            mensajeError = "La nueva contraseña debe tener como mínimo 4 caracteres.";
            return;
        }

        if (passwordNuevo != passwordConfirmacion)
        {
            mensajeError = "La nueva contraseña y la confirmación no coinciden.";
            return;
        }

        cambiandoPassword = true;

        try
        {
            var (exito, error) = await AuthService.CambiarPasswordAsync(passwordActual, passwordNuevo);
            if (exito)
            {
                mensajeExito = "¡Tu contraseña ha sido actualizada con éxito!";
                passwordActual = "";
                passwordNuevo = "";
                passwordConfirmacion = "";
            }
            else
            {
                mensajeError = error ?? "No se pudo actualizar la contraseña. Verifica tu clave actual.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cambiar contraseña: {ex.Message}";
        }
        finally
        {
            cambiandoPassword = false;
        }
    }
}
