@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - BookStore</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border shadow-sm rounded-2 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="bi bi-person-circle display-5 text-primary"></span>
                    <h2 class="fw-bold mt-2 text-dark font-editorial">Acceso a la Cuenta</h2>
                    <p class="text-muted small">Ingresa tus credenciales para acceder a tus licencias y pedidos</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 rounded-2 small text-center" role="alert">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success py-2 rounded-2 small text-center" role="alert">
                        @successMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    <div class="alert alert-info py-2 rounded-2 small text-center mb-3">
                        <span class="bi bi-info-circle me-1"></span> Inicia sesión para continuar con tu compra en el carrito.
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger py-2 px-3 rounded-2 small mb-3" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Usuario o Correo <span class="text-danger">*</span></label>
                        <InputText class="form-control form-control-lg rounded-2 fs-6" 
                                   placeholder="Ej. usuario o admin" 
                                   @bind-Value="loginModel.Username" maxlength="50" required />
                        <ValidationMessage For="() => loginModel.Username" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">Contraseña <span class="text-danger">*</span></label>
                        <InputText type="password" 
                                   class="form-control form-control-lg rounded-2 fs-6" 
                                   placeholder="Ingresa tu contraseña" 
                                   @bind-Value="loginModel.Password" maxlength="100" required />
                        <ValidationMessage For="() => loginModel.Password" class="text-danger small mt-1" />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-2 fw-semibold shadow-2xs py-2 mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Validando credenciales...</span>
                        }
                        else
                        {
                            <span>Iniciar Sesión</span>
                        }
                    </button>
                </EditForm>

                <hr class="opacity-25 my-3" />

                <div class="text-center mb-0">
                    <span class="text-muted small">¿Aún no tienes cuenta? </span>
                    <a href="@(string.IsNullOrWhiteSpace(ReturnUrl) ? "/registro" : $"/registro?returnUrl={Uri.EscapeDataString(ReturnUrl)}")" class="fw-semibold text-primary">Crear cuenta de cliente</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private LoginRequest loginModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await AuthService.Login(loginModel.Username, loginModel.Password);
            if (success)
            {
                successMessage = "¡Bienvenido! Redirigiendo...";
                await Task.Delay(400);

                if (!string.IsNullOrWhiteSpace(ReturnUrl))
                {
                    Navigation.NavigateTo(ReturnUrl);
                }
                else if (TokenService.IsAdmin)
                {
                    Navigation.NavigateTo("/libros");
                }
                else
                {
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos. Verifica tus credenciales.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al conectar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
