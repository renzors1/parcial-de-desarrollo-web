@page "/login"
@rendermode InteractiveServer
@inject AuthService AuthService
@inject TokenService TokenService
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión - BookStore</PageTitle>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            <div class="card border shadow-sm rounded-2 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <span class="bi bi-person-circle display-5 text-primary"></span>
                    <h2 class="fw-bold mt-2 text-dark font-editorial">Acceso a la Cuenta</h2>
                    <p class="text-muted small">Ingresa tus credenciales para acceder a tus licencias y pedidos</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 rounded-2 small text-center" role="alert">
                        @errorMessage
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success py-2 rounded-2 small text-center" role="alert">
                        @successMessage
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Usuario o Correo</label>
                        <InputText class="form-control form-control-lg rounded-2 fs-6" 
                                   placeholder="Ej. usuario o admin" 
                                   @bind-Value="loginModel.Username" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-secondary small">Contraseña</label>
                        <InputText type="password" 
                                   class="form-control form-control-lg rounded-2 fs-6" 
                                   placeholder="Ingresa tu contraseña" 
                                   @bind-Value="loginModel.Password" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-2 fw-semibold shadow-2xs py-2 mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Validando credenciales...</span>
                        }
                        else
                        {
                            <span>Iniciar Sesión</span>
                        }
                    </button>
                </EditForm>

                <hr class="opacity-25 my-3" />

                <div class="text-center mb-3">
                    <span class="text-muted small">¿Aún no tienes cuenta? </span>
                    <a href="/registro" class="fw-semibold text-primary">Crear cuenta de cliente</a>
                </div>

                <!-- Accesos Rápidos para Demostración -->
                <div class="mt-4 pt-3 border-top">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                            <span class="bi bi-lightning-charge-fill text-warning me-1"></span> Accesos Rápidos para Demostración
                        </span>
                        <span class="badge bg-light text-secondary border small">1 Clic</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-2 text-start p-2" disabled="@isLoading" @onclick='() => AccesoRapido("admin", "admin123")'>
                                <div class="fw-semibold text-dark small"><span class="bi bi-shield-lock-fill text-warning me-1"></span> Admin</div>
                                <div class="text-muted" style="font-size: 0.72rem;">admin / admin123</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-2 text-start p-2" disabled="@isLoading" @onclick='() => AccesoRapido("carlos.mendoza", "carlos123")'>
                                <div class="fw-semibold text-dark small"><span class="bi bi-person-fill text-primary me-1"></span> Carlos M.</div>
                                <div class="text-muted" style="font-size: 0.72rem;">carlos.mendoza</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-2 text-start p-2" disabled="@isLoading" @onclick='() => AccesoRapido("ana.torres", "ana123")'>
                                <div class="fw-semibold text-dark small"><span class="bi bi-person-fill text-info me-1"></span> Ana Torres</div>
                                <div class="text-muted" style="font-size: 0.72rem;">ana.torres</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 rounded-2 text-start p-2" disabled="@isLoading" @onclick='() => AccesoRapido("user", "user123")'>
                                <div class="fw-semibold text-dark small"><span class="bi bi-person-check text-success me-1"></span> Cliente Demo</div>
                                <div class="text-muted" style="font-size: 0.72rem;">user / user123</div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await AuthService.Login(loginModel.Username, loginModel.Password);
            if (success)
            {
                successMessage = "¡Bienvenido! Redirigiendo...";
                await Task.Delay(400);

                if (TokenService.IsAdmin)
                {
                    Navigation.NavigateTo("/libros");
                }
                else
                {
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Usuario o contraseña incorrectos. Verifica tus credenciales.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al conectar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AccesoRapido(string user, string pass)
    {
        loginModel.Username = user;
        loginModel.Password = pass;
        await HandleLogin();
    }
}
