@inherits LayoutComponentBase
@implements IDisposable
@inject TokenService TokenService
@inject BackendStatusService BackendStatus
@inject CarritoService CarritoService

<div class="page">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main>
        <header class="top-row px-4 d-flex justify-content-between align-items-center">
            <!-- Título / Miga editorial -->
            <div class="d-none d-md-flex align-items-center text-muted small">
                <span class="bi bi-shield-check text-primary me-2"></span>
                <span class="fw-medium">Plataforma Editorial Digital • Distribución DRM Segura</span>
            </div>

            <!-- Acciones de Cabecera: Estado discreto de backend + Carrito + Sesión de usuario -->
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                @if (TokenService.IsAdmin)
                {
                    <!-- Indicador de conexión discreto (Solo para Administrador) -->
                    <div class="connection-status-pill d-flex align-items-center px-2 py-1 rounded-2 border bg-white small" title="Almacén de Datos">
                        @if (BackendStatus.ModoMemoriaRAM)
                        {
                            <span class="status-dot status-amber me-2"></span>
                            <span class="text-secondary small me-2">Datos: En Memoria (RAM)</span>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted" @onclick="ProbarConexion" title="Probar conexión con API">
                                <span class="bi bi-arrow-repeat small"></span>
                            </button>
                        }
                        else
                        {
                            <span class="status-dot status-green me-2"></span>
                            <span class="text-success small fw-medium me-2">API Online (H2)</span>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted" @onclick="BackendStatus.ActivarModoRAM" title="Cambiar a datos en memoria">
                                <span class="bi bi-hdd small"></span>
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeConexion))
                    {
                        <span class="text-muted small fst-italic">@mensajeConexion</span>
                    }
                }

                <!-- Botón de Carrito en Cabecera -->
                <a href="carrito" class="btn btn-outline-secondary position-relative px-3 py-1 rounded-2 d-inline-flex align-items-center text-dark text-decoration-none shadow-2xs bg-white" title="Bolsa de Compras">
                    <span class="bi bi-cart3 fs-5 me-1 text-primary"></span>
                    <span class="d-none d-sm-inline fw-semibold small me-1">Carrito</span>
                    @if (CarritoService.TotalItems > 0)
                    {
                        <span class="badge rounded-pill bg-primary ms-1">
                            @CarritoService.TotalItems
                        </span>
                    }
                </a>

                <!-- Perfil / Iniciar Sesión -->
                @if (TokenService.IsAuthenticated)
                {
                    <div class="d-flex align-items-center gap-2 bg-white border px-3 py-1 rounded-2 shadow-2xs">
                        <span class="bi bi-person-fill text-primary"></span>
                        <span class="fw-semibold text-dark small">
                            @(TokenService.CurrentUser?.FirstName ?? TokenService.CurrentUser?.Login)
                        </span>
                        @if (TokenService.IsAdmin)
                        {
                            <span class="badge bg-warning text-dark small">Admin</span>
                        }
                    </div>
                }
                else
                {
                    <a href="login" class="btn btn-sm btn-primary rounded-2 px-3 fw-medium">
                        <span class="bi bi-box-arrow-in-right me-1"></span> Iniciar Sesión
                    </a>
                }
            </div>
        </header>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado en la aplicación.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? mensajeConexion = null;

    protected override void OnInitialized()
    {
        TokenService.OnChange += StateHasChanged;
        BackendStatus.OnChange += StateHasChanged;
        CarritoService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TokenService.OnChange -= StateHasChanged;
        BackendStatus.OnChange -= StateHasChanged;
        CarritoService.OnChange -= StateHasChanged;
    }

    private async Task ProbarConexion()
    {
        mensajeConexion = "Verificando...";
        StateHasChanged();
        var ok = await BackendStatus.ProbarConexionBackendAsync();
        mensajeConexion = ok ? "Conectado a API" : "Servidor no detectado";
        _ = Task.Delay(3000).ContinueWith(_ =>
        {
            mensajeConexion = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
