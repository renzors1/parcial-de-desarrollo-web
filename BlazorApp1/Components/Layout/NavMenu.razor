@rendermode InteractiveServer
@implements IDisposable
@inject TokenService TokenService
@inject CarritoService CarritoService
@inject NavigationManager Navigation

<div class="brand-header px-4 py-3 d-flex align-items-center">
    <a class="brand-link d-flex align-items-center text-decoration-none text-white" href="">
        <span class="brand-icon me-2">📚</span>
        <div class="d-flex flex-column">
            <span class="brand-title fw-bold">BookStore</span>
            <span class="brand-subtitle text-white-50">Librería Digital DRM</span>
        </div>
    </a>
</div>

<input type="checkbox" title="Menú de Navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column py-2">
        <!-- VISTAS PARA EL CLIENTE -->
        <div class="nav-category-header">
            Catálogo & Tienda
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-book me-2"></span> Catálogo Editorial
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="carrito">
                <span class="bi bi-cart3 me-2"></span> Mi Carrito
                @if (CarritoService.TotalItems > 0)
                {
                    <span class="badge bg-primary ms-auto">@CarritoService.TotalItems</span>
                }
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="mis-libros">
                <span class="bi bi-journal-bookmark me-2"></span> Mis Libros Digitales
            </NavLink>
        </div>

        <div class="nav-divider"></div>

        <!-- ACCESO Y CUENTA -->
        <div class="nav-category-header">
            Mi Cuenta
        </div>

        @if (!TokenService.IsAuthenticated)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-box-arrow-in-right me-2"></span> Iniciar Sesión
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="registro">
                    <span class="bi bi-person-plus me-2"></span> Registrarme
                </NavLink>
            </div>
        }
        else
        {
            <div class="user-profile-badge mx-3 mb-2 px-3 py-2 rounded-2">
                <div class="small text-white-50">Sesión iniciada:</div>
                <div class="fw-semibold text-white text-truncate">
                    <span class="bi bi-person-circle text-primary me-1"></span>
                    @(TokenService.CurrentUser?.FirstName ?? TokenService.CurrentUser?.Login ?? "Usuario")
                </div>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="perfil">
                    <span class="bi bi-person-gear me-2"></span> Mi Perfil
                </NavLink>
            </div>

            @if (TokenService.IsAdmin)
            {
                <div class="nav-category-header text-warning">
                    Administración
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="libros">
                        <span class="bi bi-grid me-2"></span> Catálogo de Libros
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="ventas">
                        <span class="bi bi-receipt-cutoff me-2"></span> Pedidos & Facturación Web
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/licencias">
                        <span class="bi bi-key me-2"></span> Licencias y Claves DRM
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/promociones">
                        <span class="bi bi-percent me-2"></span> Cupones & Descuentos
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/calificaciones">
                        <span class="bi bi-star me-2"></span> Reseñas & Opiniones
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="admin/usuarios">
                        <span class="bi bi-people me-2"></span> Usuarios & Clientes
                    </NavLink>
                </div>
            }

            <div class="nav-item mt-3">
                <a class="nav-link text-danger" href="javascript:void(0)" @onclick="CerrarSesion">
                    <span class="bi bi-box-arrow-right me-2"></span> Cerrar Sesión
                </a>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        TokenService.OnChange += StateHasChanged;
        CarritoService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        TokenService.OnChange -= StateHasChanged;
        CarritoService.OnChange -= StateHasChanged;
    }

    private void CerrarSesion()
    {
        TokenService.Clear();
        Navigation.NavigateTo("/");
    }
}
