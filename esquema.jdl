// ==========================================
// ENUMS
// ==========================================

enum EstadoLicencia {
    DISPONIBLE,
    VENDIDA
}

// ==========================================
// ENTIDADES
// ==========================================

entity Rol {
    // MEJORA 2: Identificador numérico/código definido manualmente por seguridad
    codigoIdentificador Integer required unique,
    nombreRol String required unique,
    descripcion String,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Usuario {
    nombre String required,
    apellido String required,
    email String required unique,
    contrasena String required,
    direccion String,
    celular String,
    fechaRegistro Instant required,
    // MEJORA 3 (Complemento): Promedio rápido del comportamiento del cliente
    calificacionPromedio Float min(0) max(5),
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

// MEJORA 3: Entidad para que la tienda califique al usuario (cliente)
entity CalificacionUsuario {
    puntuacion Integer required min(1) max(5),
    comentario String maxlength(500),
    fechaCalificacion Instant required,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Categoria {
    nombreCategoria String required,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Editorial {
    nombreEditorial String required,
    pais String,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Autor {
    nombres String required,
    apellidos String required,
    nacionalidad String,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Libro {
    isbn String required unique,
    titulo String required,
    sinopsis TextBlob,
    urlPortada String,
    fechaPublicacion LocalDate,
    precio Float required min(0),
    idioma String required,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity LicenciaDigital {
    codigoLicencia String required unique,
    enlaceDescarga String,
    fechaAsignacion Instant,
    estado EstadoLicencia required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Promocion {
    nombre String required,
    descripcion String,
    porcentajeDescuento Float required min(0) max(100),
    // MEJORA 1: Control de promociones con cantidad definida (cupos/stock)
    cantidadDefinida Integer required min(1),
    cantidadDisponible Integer required min(0),
    fechaInicio Instant required,
    fechaFin Instant required,
    activo Boolean required,
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity Venta {
    numeroComprobante String required unique,
    fechaVenta Instant required,
    subtotalVenta Float required min(0),
    totalDescuento Float required min(0),
    igv Float required min(0),
    totalVenta Float required min(0),
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}

entity DetalleVenta {
    cantidadVenta Integer required min(1),
    precioUnitario Float required min(0),
    descuento Float required min(0),
    subtotal Float required min(0),
    usuarioCreacion String,
    fechaCreacion Instant,
    usuarioModificacion String,
    fechaModificacion Instant
}


// ==========================================
// RELACIONES
// ==========================================

relationship OneToMany {
    Rol{usuarios} to Usuario{rol},

    Editorial{libros} to Libro{editorial},

    Usuario{compras} to Venta{cliente},

    // MEJORA 3: Relaciones para la calificación de usuarios por parte de la tienda
    // 1. El usuario (cliente) que recibe las calificaciones
    Usuario{calificacionesRecibidas} to CalificacionUsuario{clienteEvaluado required},
    // 2. El usuario de la tienda (admin/vendedor) que registra la calificación
    Usuario{calificacionesEmitidas} to CalificacionUsuario{evaluadorTienda},
    // 3. (Opcional) Vincular la calificación a una venta específica donde ocurrió la experiencia
    Venta{calificacionesCliente} to CalificacionUsuario{venta},

    Venta{detalles} to DetalleVenta{venta},

    Libro{detallesVenta} to DetalleVenta{libro},

    // MEJORA 1 (Complemento): Saber qué promoción se aplicó en el detalle de venta para descontar su cantidad
    Promocion{detallesVentaAplicados} to DetalleVenta{promocionAplicada},

    Libro{licencias} to LicenciaDigital{libro},

    DetalleVenta{licenciasEntregadas} to LicenciaDigital{detalleVenta}
}

relationship ManyToMany {
    Libro{categorias} to Categoria{libros},

    Libro{autores} to Autor{libros},
    
    Promocion{libros} to Libro{promociones}
}

// ==========================================
// ARQUITECTURA POR CAPAS LIMPIA (ESTILO MS-BANK / IDAT)
// ==========================================

dto * with mapstruct
service * with serviceImpl
paginate * with pagination
